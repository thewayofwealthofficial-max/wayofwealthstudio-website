  .rs-walls {
    background: var(--d-panel-2);
    border: 1px solid rgba(196, 162, 101, 0.42);
    border-radius: 16px;
    padding: 2.2rem 2.2rem 2.4rem; margin-bottom: 1.1rem;
    box-shadow: 0 0 60px rgba(196, 162, 101, 0.05);
  }

  .rs-inline { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-bottom: 1.3rem; border-bottom: 1px solid var(--d-line); }
  .rs-inline-k { font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--d-mute); }
  .rs-inline-v { font-family: var(--font-ui); font-variant-numeric: tabular-nums; font-size: 1.6rem; font-weight: 600; color: #fff; }
  .rs-inline-per { font-family: var(--font-ui); font-size: 0.78rem; font-weight: 400; color: var(--d-mute); }

  .rs-hero-out { text-align: center; padding: 2.1rem 0 2rem; }
