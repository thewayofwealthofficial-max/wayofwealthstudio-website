  .rs-short {
    margin-top: 1.4rem; padding: 1.3rem 1.4rem;
    background: rgba(196, 162, 101, 0.1);
    border: 1px solid rgba(196, 162, 101, 0.45); border-radius: 14px;
  }
  .rs-short-k { font-family: var(--font-ui); font-size: 13px; font-weight: 600; color: var(--d-gold); }
  .rs-short-n { font-family: var(--font-ui); font-size: 0.88rem; line-height: 1.65; color: var(--d-text); margin-top: 0.45rem; max-width: 58ch; }

  /* --- the unlock gate ---
     Hidden until "Reveal My Steady Pay" is clicked, then it gets the strongest
     treatment on the page — nothing past it renders until an email is given. */
  .rs-unlock {
