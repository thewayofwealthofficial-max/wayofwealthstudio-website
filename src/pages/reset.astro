  .rs-hero-out-sub .rs-cur { color: var(--d-mute); }

  .rs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; }
  .rs-pot { background: var(--d-panel); border: 1px solid var(--d-line); border-radius: 14px; padding: 1.3rem 1.35rem 1.4rem; }
  /* Pot 1 reads as "hands off", not as an error. The tax pot is doing its job,
     and shame is not a lever (TEACHING_SCOPE.md §5.2). */
  .rs-pot-alert .rs-pot-k { color: #E8D5B0; }
  .rs-pot-k { font-family: var(--font-ui); font-size: 12.5px; font-weight: 600; color: var(--d-text); }
  .rs-pot-pct { font-family: var(--font-ui); font-size: 11px; font-weight: 500; color: var(--d-mute); margin-left: 0.35rem; }
  .rs-pot-v { font-family: var(--font-ui); font-variant-numeric: tabular-nums; font-size: 1.75rem; font-weight: 600; color: #fff; margin-top: 0.5rem; line-height: 1.1; }
  .rs-pot-per { font-family: var(--font-ui); font-size: 0.76rem; font-weight: 400; color: var(--d-mute); margin-left: 0.45rem; }
  .rs-pot-n { font-family: var(--font-ui); font-size: 0.83rem; line-height: 1.6; color: var(--d-mute); margin-top: 0.6rem; }
  .rs-pot-target {
    font-family: var(--font-ui); font-size: 0.78rem; line-height: 1.55;
    color: #E8D5B0; margin-top: 0.75rem; padding-top: 0.7rem;
    border-top: 1px solid rgba(196, 162, 101, 0.24);
  }
  .rs-pot-target:empty { display: none; }

  /* --- short: what is left will not cover the life ---
