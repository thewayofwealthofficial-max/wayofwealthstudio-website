  .rs-unlock-n { font-family: var(--font-ui); font-size: 0.92rem; line-height: 1.6; color: var(--d-mute); margin-top: 0.6rem; max-width: 52ch; }
  .rs-unlock-row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.4rem; }
  .rs-unlock-row input {
    flex: 1 1 12rem; min-width: 0;
    font-family: var(--font-ui); font-size: 15px; color: #fff;
    border: 1px solid var(--d-line); border-radius: 11px;
    padding: 0.95rem 1rem; background: var(--d-inset); outline: none;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  .rs-unlock-row input::placeholder { color: #5d6b79; }
  .rs-unlock-row input:focus { border-color: var(--d-gold); box-shadow: 0 0 0 3px rgba(196, 162, 101, 0.16); }
  .rs-unlock-row .rs-btn { flex: 0 0 auto; }
  .rs-unlock-row .rs-btn:disabled { opacity: 0.6; cursor: wait; }
  .rs-unlock-err:not(:empty) {
    font-family: var(--font-ui); font-size: 12.5px; color: #E2857A;
    margin-top: 0.7rem;
  }
  .rs-honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  /* --- actions --- */
  .rs-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.6rem; }
  .rs-btn {
    font-family: var(--font-ui); font-size: 15px; font-weight: 700;
    border-radius: 11px; padding: 0.95rem 1.6rem; cursor: pointer;
    border: 1px solid transparent; text-decoration: none; display: inline-block;
    transition: filter 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }
  .rs-btn:focus-visible { outline: 2px solid var(--d-gold); outline-offset: 3px; }
  .rs-btn-primary { background: var(--d-gold); color: var(--d-on-gold); }
  .rs-btn-primary:hover { filter: brightness(1.08); transform: translateY(-1px); }
  .rs-btn-ghost { background: transparent; color: var(--d-text); border-color: var(--d-line); }
  .rs-btn-ghost:hover { border-color: var(--d-gold); }

  /* --- scope --- */
  .rs-scope { font-family: var(--font-ui); font-size: 12px; line-height: 1.75; color: var(--d-mute); margin-top: 2.5rem; max-width: 64ch; }
  .rs-scope b { color: var(--d-text); }
  .rs-scope-cred { display: block; font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; margin-top: 0.9rem; color: var(--d-mute); }

  /* Somebody asked their machine for less movement. Honour it. */
  @media (prefers-reduced-motion: reduce) {
    .rs-wrap *, .rs-wrap *::before, .rs-wrap *::after {
      animation-duration: 0.01ms !important; animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important; scroll-behavior: auto !important;
    }
    .rs-btn-primary:hover { transform: none; }
  }

  /* --- responsive --- */
  @media (max-width: 700px) {
    .rs-wrap { padding: 3rem 1rem 4rem; }
    .rs-card, .rs-walls { padding: 1.7rem 1.35rem 1.9rem; border-radius: 14px; }
    .rs-grid { grid-template-columns: 1fr; }
    .rs-moneybox { max-width: none; }
    .rs-actions .rs-btn { width: 100%; text-align: center; }
