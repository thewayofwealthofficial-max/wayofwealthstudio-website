---
// THE PAY YOURSELF CALCULATOR at /reset (live 11 Oct 2026; replaced the Money Reset Tool, same URL so the
// RESET keyword and old posts keep working). Joel's brief 10 Oct + the 9 Oct professional-practice check
// (income = 12-month average or a slow month; VAT; payments on account in the plan). Six taps -> one free
// number -> plan locked behind an email. The plan (email text + 3-page PDF) is built in
// netlify/functions/lib/pay-plan.js from the six answers and not stored.
import Layout from '../layouts/LandingLayout.astro';
import { LINKS } from '../config/links';

const title = "Pay Yourself Calculator | How much can you safely pay yourself? | Way of Wealth";
const description = "How much can you safely pay yourself each week? For business owners whose money comes in lumps. Free.";
const CALENDLY = 'https://calendly.com/thewayofwealth-official/your-cash-flow-session';
import { RESULT_CLIPS } from '../config/resultsClips';
// Proof after the email (Joel, 11 Oct): checked clips, captions word for word. Sam left out (may be Joel's brother).
const CLIPS = ['alon-2', 'josh-1', 'lynt-3', 'hozz-4'].map((s) => RESULT_CLIPS.find((c) => c.slug === s)).filter(Boolean);
---
<Layout title={title} description={description} canonical={`${LINKS.siteUrl}/reset`} bodyClass="py-dark">

<main class="py-wrap">

  <header class="py-hero">
    <h1 class="py-h1">How much can you safely pay yourself each week?</h1>
    <p class="py-sub">For business owners whose money comes in lumps. Six taps. Your number shows straight away.</p>
  </header>

  <!-- 1. Income -->
  <section class="py-q" data-q="income">
    <p class="py-qn">1 of 6</p>
    <h2 class="py-qt">What comes in each month, on average?</h2>
    <p class="py-help">Take the average of the last 12 months. If it swings a lot, use a slow month instead.</p>
    <div class="py-chips" data-key="income">
      <button type="button" class="py-chip" data-val="3000">£3,000</button>
      <button type="button" class="py-chip" data-val="5000">£5,000</button>
      <button type="button" class="py-chip" data-val="8000">£8,000</button>
      <button type="button" class="py-chip" data-val="12000">£12,000</button>
      <button type="button" class="py-chip" data-val="20000">£20,000</button>
      <button type="button" class="py-chip" data-val="custom">Custom</button>
    </div>
    <div class="py-custom" hidden><span>£</span><input type="number" inputmode="numeric" min="0" placeholder="Type an amount" /><span>a month</span></div>
  </section>

  <!-- 2. VAT -->
  <section class="py-q" data-q="vat">
    <p class="py-qn">2 of 6</p>
    <h2 class="py-qt">Are you VAT registered?</h2>
    <div class="py-chips" data-key="vat">
      <button type="button" class="py-chip" data-val="no">No</button>
      <button type="button" class="py-chip" data-val="yes">Yes</button>
    </div>
  </section>

  <!-- 3. Business costs -->
  <section class="py-q" data-q="costs">
    <p class="py-qn">3 of 6</p>
    <h2 class="py-qt">What does the business cost to run each month?</h2>
    <div class="py-chips" data-key="costs">
      <button type="button" class="py-chip" data-val="250">£250</button>
      <button type="button" class="py-chip" data-val="500">£500</button>
      <button type="button" class="py-chip" data-val="1000">£1,000</button>
      <button type="button" class="py-chip" data-val="2000">£2,000</button>
      <button type="button" class="py-chip" data-val="custom">Custom</button>
    </div>
    <div class="py-custom" hidden><span>£</span><input type="number" inputmode="numeric" min="0" placeholder="Type an amount" /><span>a month</span></div>
  </section>

  <!-- 4. Current pay -->
  <section class="py-q" data-q="pay">
    <p class="py-qn">4 of 6</p>
    <h2 class="py-qt">What do you pay yourself now, each week?</h2>
    <div class="py-chips" data-key="pay">
      <button type="button" class="py-chip" data-val="none">No set amount</button>
      <button type="button" class="py-chip" data-val="300">£300</button>
      <button type="button" class="py-chip" data-val="600">£600</button>
      <button type="button" class="py-chip" data-val="1000">£1,000</button>
      <button type="button" class="py-chip" data-val="1500">£1,500</button>
      <button type="button" class="py-chip" data-val="custom">Custom</button>
    </div>
    <div class="py-custom" hidden><span>£</span><input type="number" inputmode="numeric" min="0" placeholder="Type an amount" /><span>a week</span></div>
  </section>

  <!-- 5. Life costs -->
  <section class="py-q" data-q="life">
    <p class="py-qn">5 of 6</p>
    <h2 class="py-qt">What does your life cost each month?</h2>
    <p class="py-help">Rent or mortgage, food, bills, everything you need to live.</p>
    <div class="py-chips" data-key="life">
      <button type="button" class="py-chip" data-val="1500">£1,500</button>
      <button type="button" class="py-chip" data-val="2000">£2,000</button>
      <button type="button" class="py-chip" data-val="3000">£3,000</button>
      <button type="button" class="py-chip" data-val="4000">£4,000</button>
      <button type="button" class="py-chip" data-val="6000">£6,000</button>
      <button type="button" class="py-chip" data-val="custom">Custom</button>
    </div>
    <div class="py-custom" hidden><span>£</span><input type="number" inputmode="numeric" min="0" placeholder="Type an amount" /><span>a month</span></div>
  </section>

  <!-- 6. Tax -->
  <section class="py-q" data-q="tax">
    <p class="py-qn">6 of 6</p>
    <h2 class="py-qt">How much do you set aside for tax?</h2>
    <p class="py-help">Check the real figure with your accountant.</p>
    <div class="py-chips" data-key="tax">
      <button type="button" class="py-chip" data-val="20">20%</button>
      <button type="button" class="py-chip" data-val="25">25%</button>
      <button type="button" class="py-chip" data-val="30">30%</button>
    </div>
  </section>

  <p class="py-progress" id="py-progress">Answer all six to see your number.</p>

  <!-- RESULT (free) -->
  <section class="py-result" id="py-result" hidden>
    <p class="py-label">Your safe weekly wage</p>
    <p class="py-big"><span id="py-weekly">£0</span></p>
    <p class="py-gap" id="py-gap"></p>
    <p class="py-help">Until your buffer holds a few slow months, plan from a slow month, not a good one.</p>

    <!-- Locked plan -->
    <div class="py-plan">
      <p class="py-plan-t">🔒 Your Pay Yourself Plan</p>
      <div class="py-accounts">
        <div class="py-acc"><span>Yours</span><b class="py-blur">£0,000</b></div>
        <div class="py-acc"><span>Tax</span><b class="py-blur">£0,000</b></div>
        <div class="py-acc"><span>Business costs</span><b class="py-blur">£0,000</b></div>
        <div class="py-acc"><span>Slow-month buffer</span><b class="py-blur">£0,000</b></div>
        <div class="py-acc" id="py-acc-vat" hidden><span>VAT</span><b class="py-blur">£0,000</b></div>
      </div>
      <p class="py-plan-n">Your four accounts, what goes in each from every £1,000, your buffer target, and a 30-minute setup.</p>
    </div>

    <form class="py-form" id="py-form" novalidate>
      <label>First name<input name="name" autocomplete="given-name" required /></label>
      <label>Email<input name="email" type="email" autocomplete="email" required /></label>
      <input name="website" tabindex="-1" autocomplete="off" class="py-hp" aria-hidden="true" />
      <button type="submit" class="py-btn">Email me my plan</button>
      <p class="py-help py-help-small">No spam. Unsubscribe any time. We use your numbers to write your plan and email it to you. We don't keep them in any database.</p>
      <p class="py-err" id="py-err" hidden></p>
    </form>
  </section>

  <!-- AFTER SUBMIT -->
  <section class="py-done" id="py-done" hidden>
    <p class="py-done-t">Your plan is on its way, <span id="py-name">friend</span>.</p>
    <div class="py-session">
      <p>These numbers are a rough guide. On a Cash Flow Session I build your cash flow model with you, live on screen, from rough numbers you give me. No bank statements, no bank details. 75 minutes. You leave knowing your exact number.</p>
      <a class="py-btn py-book" href={CALENDLY} target="_blank" rel="noopener">Book a Cash Flow Session (£99.97)</a>
    </div>

    <div class="py-proof">
      <p class="py-kicker">What clients say</p>
      <div class="py-clips">
        {CLIPS.map((v) => (
          <figure class="py-clip">
            <video controls playsinline preload="none" poster={`/testimonials/results/${v!.slug}.jpg`} src={`/testimonials/results/${v!.slug}.mp4`}></video>
            <figcaption><p>"{v!.cap}"</p><small>{v!.who}, coaching client</small></figcaption>
          </figure>
        ))}
      </div>
      <p class="py-help py-help-small">Real clips from 12-week coaching clients. Results vary.</p>
      <a class="py-btn py-book" href={CALENDLY} target="_blank" rel="noopener">Book a Cash Flow Session (£99.97)</a>
    </div>
  </section>

  <p class="py-disc">An educational tool, not financial advice. It only does maths on the numbers you pick.</p>
</main>

<script>
  // Share of what's left after tax that goes to the slow-month buffer. Fixed at 10% on the page; the plan email shows 5% and 15% (Joel, 11 Oct).
  const BUFFER_PCT = 10;

  const $ = (id) => document.getElementById(id);
  const fmt = (n) => '£' + Math.round(n).toLocaleString('en-GB');
  const state = { income: null, vat: null, costs: null, pay: null, life: null, tax: null };


  /* ---------- step tracking (same tracker as before, tool 'reset'): opened, started, finished, email, book ---------- */
  const visitor = (() => {
    try {
      let v = sessionStorage.getItem('wow_mv');
      if (!v) { v = Math.random().toString(36).slice(2, 14).padEnd(12, '0'); sessionStorage.setItem('wow_mv', v); }
      return v;
    } catch (err) { return Math.random().toString(36).slice(2, 14).padEnd(12, '0'); }
  })();
  // Where they came from (7 Oct 2026): the ?src= tag on the link, and the page they clicked from. 'opened' only.
  const origin = (() => {
    try {
      const q = new URLSearchParams(location.search);
      return { src: q.get('src') || q.get('utm_source') || '', r: document.referrer ? new URL(document.referrer).hostname : '' };
    } catch (err) { return { src: '', r: '' }; }
  })();
  const tracked = new Set();
  function track(step, who) {
    if (tracked.has(step)) return;
    tracked.add(step);
    const body = JSON.stringify({ t: 'reset', s: step, v: visitor, ...(step === 'opened' ? origin : {}), ...(who || {}) });
    try {
      if (!navigator.sendBeacon || !navigator.sendBeacon('/api/magnet/track', new Blob([body], { type: 'text/plain' }))) {
        fetch('/api/magnet/track', { method: 'POST', body, keepalive: true }).catch(() => {});
      }
    } catch (err) { /* tracking never gets in the way of the tool */ }
  }
  track('opened');

  function calc() {
    const vat = state.vat === 'yes' ? state.income / 6 : 0;   // standard 20% rate on VAT-inclusive takings
    const profit = state.income - vat - state.costs;
    const tax = Math.max(0, profit) * (state.tax / 100);
    const left = profit - tax;
    const buffer = Math.max(0, left) * (BUFFER_PCT / 100);
    const monthly = Math.max(0, left - buffer);
    const weekly = (monthly * 12) / 52;
    return { vat, profit, tax, left, buffer, monthly, weekly };
  }

  function gaps(c) {
    const out = [];
    const payNow = state.pay === 'none' ? null : Number(state.pay);
    if (state.life > c.monthly) out.push(`Your life costs ${fmt(state.life - c.monthly)} a month more than your business can pay you.`);
    if (payNow !== null && payNow - c.weekly > 50) out.push(`You're taking ${fmt(payNow - c.weekly)} a week more than your business can support.`);
    if (payNow === null) out.push("Right now you don't have a wage.");
    if (payNow !== null && c.weekly - payNow > 50) out.push(`You could pay yourself ${fmt(c.weekly - payNow)} a week more.`);
    if (!out.length) out.push("You're close. Now make it automatic.");
    return out;
  }

  function paint() {
    const done = Object.values(state).every((v) => v !== null && !(typeof v === 'number' && !isFinite(v)));
    $('py-progress').hidden = done;
    $('py-result').hidden = !done;
    if (!done) return;
    track('finished');
    const c = calc();
    $('py-weekly').textContent = fmt(c.weekly);
    const g = gaps(c);
    $('py-gap').textContent = g[0];
    $('py-acc-vat').hidden = state.vat !== 'yes';
  }

  document.querySelectorAll('.py-chips').forEach((group) => {
    const key = group.getAttribute('data-key');
    const box = group.parentElement.querySelector('.py-custom');
    group.querySelectorAll('.py-chip').forEach((chip) => chip.addEventListener('click', () => {
      track('started');
      group.querySelectorAll('.py-chip').forEach((b) => b.classList.remove('is-on'));
      chip.classList.add('is-on');
      const val = chip.getAttribute('data-val');
      if (val === 'custom') {
        box.hidden = false; box.querySelector('input').focus();
        const v = Number(box.querySelector('input').value);
        state[key] = box.querySelector('input').value === '' ? null : v;
      } else {
        if (box) box.hidden = true;
        state[key] = (key === 'vat' || val === 'none') ? val : Number(val);
      }
      paint();
    }));
    if (box) box.querySelector('input').addEventListener('input', (e) => {
      state[key] = e.target.value === '' ? null : Math.max(0, Number(e.target.value)); paint();
    });
  });

  // ManyChat: /reset?email=name@x.com pre-fills the email so it's one tap.
  try {
    const em = new URLSearchParams(location.search).get('email');
    if (em) $('py-form').querySelector('[name="email"]').value = em;
  } catch (err) {}

  $('py-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = $('py-form');
    const name = f.querySelector('[name="name"]').value.trim();
    const email = f.querySelector('[name="email"]').value.trim();
    const err = $('py-err');
    err.hidden = true;
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { err.textContent = 'That email does not look right.'; err.hidden = false; return; }
    const btn = f.querySelector('.py-btn'); btn.disabled = true; btn.textContent = 'Sending…';
    try {
      // The six answers go to the sign-up function, which works the plan out itself and emails it. Not stored.
      const res = await fetch('/api/lead-magnet/subscribe', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email, name, magnet: 'cash-reset', honeypot: f.querySelector('[name="website"]').value || null,
          plan: { income: state.income, vat: state.vat === 'yes', costs: state.costs, payNow: state.pay === 'none' ? null : state.pay, life: state.life, taxPct: state.tax },
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || data.error) throw new Error(data.error || 'That did not go through. Try again in a moment.');
      track('email', { n: name, e: email });
      $('py-name').textContent = (name.split(/\s+/)[0]) || 'friend';
      $('py-result').hidden = true;
      $('py-done').hidden = false;
      $('py-done').scrollIntoView({ behavior: 'smooth' });
    } catch (x) {
      err.textContent = x.message; err.hidden = false;
      btn.disabled = false; btn.textContent = 'Email me my plan';
    }
  });
  document.querySelectorAll('.py-book').forEach((a) => a.addEventListener('click', () => track('book')));
</script>

<style is:global>
  body.py-dark { background: #0b1119; color: #F5F0E8; }
  body.py-dark main { background: radial-gradient(115% 60% at 78% -6%, #16212e 0%, #0b1119 55%, #070c12 100%); }
  body.py-dark .lp-header { background: #0a1017; }
  body.py-dark .lp-footer { background: #070c12; }
  .py-wrap { --bg: #0b1119; --panel: #131d29; --line: #26323f; --text: #F5F0E8; --mute: #9AA7B4; --gold: #C4A265; --on-gold: #14202c;
    --display: 'Fraunces', Georgia, serif; --ui: 'Inter', system-ui, sans-serif;
    max-width: 560px; margin: 0 auto; padding: 36px 18px 64px; font-family: var(--ui); color: var(--text); }
  .py-wrap [hidden] { display: none !important; }
  .py-h1 { font-family: var(--display); font-weight: 600; font-size: clamp(2rem, 7vw, 2.7rem); line-height: 1.12; margin: 0 0 14px; color: var(--text); }
  .py-sub { font-size: 1.02rem; line-height: 1.6; color: var(--mute); margin: 0 0 28px; }
  .py-q { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 20px 18px; margin: 0 0 14px; }
  .py-qn { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); margin: 0 0 8px; }
  .py-qt { font-family: var(--display); font-weight: 600; font-size: 1.25rem; line-height: 1.3; margin: 0 0 6px; color: var(--text); }
  .py-help { font-size: .95rem; line-height: 1.6; color: var(--mute); margin: 0 0 12px; }
  .py-help-small { font-size: 12.5px; margin-top: 10px; }
  .py-help a { color: var(--gold); }
  .py-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .py-chip { min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--line); background: #182430; color: var(--mute); font: 600 15px var(--ui); cursor: pointer; transition: all .18s; }
  .py-chip:hover { color: var(--text); border-color: var(--gold); }
  .py-chip.is-on { background: var(--gold); border-color: var(--gold); color: var(--on-gold); }
  .py-custom { display: flex; align-items: center; gap: 8px; margin-top: 12px; color: var(--mute); font-weight: 600; }
  .py-custom input { min-height: 44px; flex: 1; background: #0d151f; color: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 0 12px; font: 600 16px var(--ui); }
  .py-progress { text-align: center; font-size: .95rem; color: var(--mute); margin: 18px 0; }
  .py-result, .py-done { margin-top: 26px; }
  .py-label { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); margin: 0; text-align: center; }
  .py-big { font-family: var(--display); font-weight: 600; font-variant-numeric: tabular-nums; font-size: clamp(3.4rem, 15vw, 4.6rem); line-height: 1; color: #fff; margin: 10px 0 16px; text-align: center; }
  .py-gap { max-width: 34rem; margin: 0 auto 14px; text-align: center; border: 1px solid rgba(214, 90, 74, 0.55); background: rgba(214, 90, 74, 0.10); border-radius: 14px; padding: 14px 16px; font-weight: 700; font-size: 1.25rem; line-height: 1.35; color: #F2A99E; }
  .py-result > .py-help { text-align: center; }
  .py-plan { background: var(--panel); border: 1px solid rgba(196,162,101,.45); border-radius: 16px; padding: 18px; margin: 18px 0; }
  .py-plan-t { font-family: var(--display); font-weight: 600; font-size: 1.2rem; margin: 0 0 12px; color: var(--text); }
  .py-accounts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .py-acc { background: #0d151f; border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; font-weight: 600; color: var(--text); }
  .py-acc b { font-size: 1.4rem; color: #fff; }
  .py-blur { filter: blur(7px); user-select: none; }
  .py-plan-n { font-size: .9rem; line-height: 1.55; color: var(--mute); margin: 12px 0 0; }
  .py-form { display: flex; flex-direction: column; gap: 12px; }
  .py-form label { display: flex; flex-direction: column; gap: 6px; font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--mute); }
  .py-form input { min-height: 50px; background: #0d151f; color: #fff; border: 1px solid var(--line); border-radius: 11px; padding: 0 14px; font: 500 16px var(--ui); text-transform: none; letter-spacing: 0; }
  .py-form input:focus { outline: none; border-color: var(--gold); }
  .py-hp { position: absolute; left: -9999px; }
  .py-btn { display: flex; align-items: center; justify-content: center; min-height: 52px; border: 0; border-radius: 11px; background: var(--gold); color: var(--on-gold); font: 700 16px var(--ui); text-decoration: none; cursor: pointer; padding: 0 20px; text-align: center; }
  .py-btn:hover { filter: brightness(1.08); }
  .py-btn:disabled { opacity: .6; cursor: wait; }
  .py-err { color: #E2857A; font-size: 13px; }
  .py-done-t { font-family: var(--display); font-weight: 600; font-size: clamp(1.8rem, 6vw, 2.3rem); line-height: 1.15; margin: 0 0 16px; color: var(--text); }
  .py-session { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 20px 18px; }
  .py-session p { font-size: 1rem; line-height: 1.6; color: var(--text); margin: 0 0 16px; }
  .py-proof { margin-top: 30px; }
  .py-kicker { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); margin: 0 0 14px; }
  .py-clips { display: grid; gap: 14px; margin-bottom: 8px; }
  .py-clip { margin: 0; background: rgba(245,240,232,.05); border: 1px solid rgba(196,162,101,.2); border-radius: 12px; padding: 12px; }
  .py-clip video { width: 100%; border-radius: 8px; background: #000; display: block; aspect-ratio: 16/9; object-fit: cover; }
  .py-clip figcaption p { font-family: var(--display); font-style: italic; font-size: 1.02rem; line-height: 1.5; color: var(--text); margin: 12px 0 6px; }
  .py-clip figcaption small { color: var(--gold); font-size: .82rem; }
  .py-proof .py-btn { margin-top: 16px; }
  .py-disc { font-size: 12.5px; text-align: center; color: var(--mute); margin: 34px 0 0; }
</style>

</Layout>
