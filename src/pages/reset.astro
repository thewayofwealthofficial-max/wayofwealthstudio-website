---
import Layout from '../layouts/LandingLayout.astro';
import { LINKS } from '../config/links';

const title = "The Money Reset Tool — Free | Way of Wealth";
const description = "Find out where your money is actually going in under 3 minutes. See the exact numbers to cover your taxes, pay your work bills, and know what's yours to keep. Free. Joel Ezekiel · MSc Behavioural Economics · Qualified Financial Planner.";
---
<Layout title={title} description={description} canonical={`${LINKS.siteUrl}/reset`} bodyClass="rs-dark">

<section class="rs-wrap">

  <!-- ============================================================
       0 · TOP BAR — matches the Money Story Diagnostic at
       discover.thewayofwealth.shop: photo + name + credentials left,
       wordmark right. Replaces the shared site header on this page.
  ============================================================ -->
  <header class="rs-top reveal">
    <div class="rs-who">
      <img class="rs-face" src="/img/joel.jpg" alt="" width="46" height="46" />
      <div>
        <p class="rs-name">Joel Ezekiel</p>
        <p class="rs-cred">MSc Behavioural Economics · Qualified Financial Planner</p>
      </div>
    </div>
    <p class="rs-mark">Way of <em>Wealth</em></p>
  </header>

  <!-- ============================================================
       1 · HERO — copy left, calculator right (same grid as Discover)
  ============================================================ -->
  <div class="rs-hero-grid">
  <div class="rs-copy reveal">
    <p class="rs-badge">⬥ The Cashflow Shield</p>
    <h1 class="rs-h1">
      The Money <em>Reset</em> Tool.
    </h1>
    <p class="rs-sub">
      Find out where your money is actually going in under 3 minutes.
    </p>
    <p class="rs-sub rs-context">
      Stop doing mental math every time you open your banking app. See the exact numbers to
      cover your taxes, pay your work bills, and know what’s yours to keep.
    </p>
    <p class="rs-conf">🔒 Free. Your figures never leave this page, and we can’t see them. One email opens the rest.</p>
  </div>

  <div class="rs-panel reveal">
  <!-- ============================================================
       2 · YOUR NUMBERS — three quick inputs, all pre-filled with a
       sensible default. No life-cost figure to type: the pay formula
       is a flat share of what's left, not a cap against living costs.
  ============================================================ -->
  <div class="rs-card">
    <p class="rs-step">Step one</p>
    <h2 class="rs-h2">Your numbers.</h2>

    <!-- Gross inflow -->
    <div class="rs-currency" role="group" aria-label="Currency">
      <button type="button" class="rs-chip is-on" data-cur="£">£</button>
      <button type="button" class="rs-chip" data-cur="$">$</button>
      <button type="button" class="rs-chip" data-cur="€">€</button>
      <button type="button" class="rs-chip" data-cur="C$">C$</button>
      <button type="button" class="rs-chip" data-cur="R">R</button>
      <button type="button" class="rs-chip" data-cur="₪">₪</button>
    </div>

    <label class="rs-label" for="rs-rev">Roughly what hits your business account each month?</label>
    <p class="rs-help rs-help-tight">All client payments, Stripe, workshop revenue, and class passes before anything goes out.</p>

    <p class="rs-bigfig">
      <span class="rs-cur">£</span><span id="rs-rev-out">5,000</span><span class="rs-per">a month</span>
    </p>

    <input id="rs-rev" type="range" min="1000" max="20000" step="250" value="5000" />
    <div class="rs-scale"><span>1,000</span><span>10,000</span><span>20,000</span></div>

    <!-- Work costs -->
    <div class="rs-block">
      <label class="rs-label" for="rs-run-chips">Roughly what does your work cost to run each month?</label>
      <p class="rs-help rs-help-tight">Room hire, studio space, booking apps, insurance, props, and travel.</p>
      <div class="rs-chips" id="rs-run-chips">
        <button type="button" class="rs-chip" data-val="250">£250</button>
        <button type="button" class="rs-chip is-on" data-val="500">£500</button>
        <button type="button" class="rs-chip" data-val="750">£750</button>
        <button type="button" class="rs-chip" data-val="1000">£1,000</button>
        <button type="button" class="rs-chip" data-val="custom">Custom</button>
      </div>
      <div class="rs-moneybox rs-run-custom-box" id="rs-run-custom-box" hidden>
        <span class="rs-cur">£</span>
        <input id="rs-run-custom" type="number" min="0" step="10" inputmode="decimal" placeholder="–" />
        <span class="rs-suffix-per">a month</span>
      </div>
    </div>

    <!-- Tax reserve -->
    <div class="rs-block">
      <label class="rs-label" for="rs-tax-chips">How much do you want to set aside for taxes?</label>
      <p class="rs-help rs-help-tight">If you're unsure, 20% is the safe baseline for self-employed income.</p>
      <div class="rs-chips" id="rs-tax-chips">
        <button type="button" class="rs-chip is-on" data-val="20">20% <span class="rs-rec">Safe Standard</span></button>
        <button type="button" class="rs-chip" data-val="25">25%</button>
        <button type="button" class="rs-chip" data-val="30">30%</button>
      </div>
    </div>

    <button type="button" class="rs-btn rs-btn-primary rs-reveal-btn" id="rs-reveal-btn">Reset My Numbers in 3 Minutes →</button>
  </div>

  <!-- ============================================================
       2b · THE GATE — hidden until "Reset My Numbers" is clicked.
       Nothing past it renders until an email is given. Remembered per browser.
  ============================================================ -->
  <form class="rs-card rs-unlock reveal" id="rs-unlock" hidden novalidate>
    <p class="rs-unlock-k">Where should we send your breakdown?</p>
    <p class="rs-unlock-n">
      Enter your first name and email to unlock your exact numbers and keep a copy for your records.
    </p>
    <div class="rs-unlock-row">
      <label class="rs-sr" for="rs-name">First name</label>
      <input id="rs-name" type="text" autocomplete="given-name" placeholder="First name" />
      <label class="rs-sr" for="rs-email">Your email</label>
      <input id="rs-email" type="email" inputmode="email" autocomplete="email" placeholder="you@example.com" />
      <button type="submit" class="rs-btn rs-btn-primary" id="rs-unlock-btn">Unlock My Results →</button>
    </div>
    <!-- honeypot: bots fill this, humans never see it -->
    <div class="rs-honeypot" aria-hidden="true">
      <label>Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <p class="rs-unlock-err" id="rs-unlock-err" aria-live="polite"></p>
    <p class="rs-micro">Free. No spam, and you can unsubscribe any time.</p>
  </form>
  </div><!-- /.rs-panel -->
  </div><!-- /.rs-hero-grid -->

  <div class="rs-below">

  <div id="rs-locked" hidden>
  <!-- ============================================================
       3 · WHAT'S YOURS TO KEEP  (the one gold-edged moment on the page)
  ============================================================ -->
  <div class="rs-walls reveal" id="rs-walls">
    <div class="rs-inline">
      <span class="rs-inline-k">Gross in</span>
      <span class="rs-inline-v"><span class="rs-cur">£</span><span id="rs-w-in">0</span> <span class="rs-inline-per">a month</span></span>
    </div>

    <div class="rs-hero-out">
      <p class="rs-hero-out-k">What's Yours to Keep</p>
      <p class="rs-hero-out-v"><span class="rs-cur">£</span><span id="rs-w-payweek">0</span><span class="rs-per">/ week</span></p>
      <p class="rs-hero-out-sub">(or <span class="rs-cur">£</span><span id="rs-w-pay">0</span> / month on the 1st)</p>
      <p class="rs-hero-out-context">A consistent, guilt-free salary that stays the same whether you had a big launch or a quiet month.</p>
    </div>

    <div class="rs-grid">
      <div class="rs-pot rs-pot-alert">
        <p class="rs-pot-k">🏛️ Taxes (Untouchable) <span class="rs-pot-pct" id="rs-w-taxpct">0%</span></p>
        <p class="rs-pot-v"><span class="rs-cur">£</span><span id="rs-w-tax">0</span><span class="rs-pot-per">/mo</span></p>
        <p class="rs-pot-n">Swept the day money lands. HMRC is handled with zero dread.</p>
      </div>

      <div class="rs-pot">
        <p class="rs-pot-k">🏢 Work & Studio Bills</p>
        <p class="rs-pot-v"><span class="rs-cur">£</span><span id="rs-w-run">0</span><span class="rs-pot-per">/mo</span></p>
        <p class="rs-pot-n">Room hire, booking tools, and business overhead ring-fenced.</p>
      </div>

      <div class="rs-pot">
        <p class="rs-pot-k">🛡️ Slow-Month Buffer</p>
        <p class="rs-pot-v"><span class="rs-cur">£</span><span id="rs-w-buf">0</span><span class="rs-pot-per">/mo</span></p>
        <p class="rs-pot-n">Builds up automatically during strong months to protect your paycheck when you take time off.</p>
      </div>
    </div>
  </div>

  <!-- ============================================================
       4 · TAKE IT WITH YOU
  ============================================================ -->
  <div class="rs-card reveal">
    <p class="rs-step">Last bit</p>
    <h2 class="rs-h2">Want this set up in your actual bank accounts?</h2>
    <p class="rs-help">
      Stop guessing what you can spend at 9pm. We can install these exact sub-accounts and
      automated transfers directly into your accounts so it runs on complete autopilot.
    </p>
    <div class="rs-actions">
      <a class="rs-btn rs-btn-primary" href={`${LINKS.vsl}?src=reset`} target="_blank" rel="noopener noreferrer">
        Book a 15-Minute Bank Setup Call →
      </a>
      <button type="button" class="rs-btn rs-btn-ghost" id="rs-copy">Copy my breakdown</button>
    </div>
    <p class="rs-micro" id="rs-copied" aria-live="polite"></p>
  </div>

  </div><!-- /#rs-locked -->

  <!-- ============================================================
       5 · FOOTER — facts line + scope, matches Discover's rs-foot.
       The scope paragraph is outside the gate on purpose, it is
       always visible.
  ============================================================ -->
  <footer class="rs-foot reveal">
    <p class="rs-facts">
      <b>3 minutes</b> start to finish <span>·</span> <b>Free</b>, no card <span>·</span> <b>Private</b> and confidential
    </p>
    <p class="rs-scope">
      <b>This is an educational tool, not financial advice.</b> It does the arithmetic on the figures
      you typed and nothing else. Joel is a planner, not an adviser, so nothing here tells you what to
      do with your money, how much to hold for tax, or where to put anything. Your accountant gives
      you your tax number.
      <span class="rs-scope-cred">Joel Ezekiel · MSc Behavioural Economics | Qualified Financial Planner</span>
    </p>
  </footer>

  </div><!-- /.rs-below -->

</section>

<script>
  const $ = (id) => document.getElementById(id);

  // The URL this tool is served from. Appears in the copied breakdown, so it has to match
  // where it actually goes live. The domain is .shop, not .com. One line to change.
  const TOOL_URL = 'thewayofwealth.shop/reset';

  const state = {
    cur: '£',
    revenue: 5000,
    runAmt: 500, // work costs, a flat amount — not a share of revenue
    taxPct: 20,  // defaults to the safe-standard 20%
    unlocked: false, // set once they have given an email (or did on a previous visit)
  };

  // Remember the unlock so a refresh doesn't ask twice. Private browsing and blocked
  // site data both throw here, in which case they simply get asked again.
  const UNLOCK_KEY = 'wow_reset_unlocked_v4';
  try {
    state.unlocked = localStorage.getItem(UNLOCK_KEY) === '1';
  } catch (err) {
    state.unlocked = false;
  }

  const fmt = (n) => Math.round(n).toLocaleString('en-GB');

  /* ---------- the arithmetic ----------
     Pay is a flat 70% of what's left after tax and work costs. The buffer is
     the other 30%, so pay + buffer always equals what's left — nothing hides
     between the two, which matters when Joel is doing this out loud on a call. */
  function calc() {
    const rev = state.revenue;
    const taxPct = state.taxPct ?? 0;

    const tax = Math.round(rev * (taxPct / 100));
    const run = state.runAmt;
    const net = Math.max(0, rev - tax - run);

    const payMonthRaw = net * 0.70;
    const payMonth = Math.round(payMonthRaw);
    const payWeek = Math.round((payMonthRaw * 12) / 52);
    const buffer = Math.round(net - payMonthRaw);

    return { rev, tax, run, net, payMonth, payWeek, buffer };
  }

  /* ---------- painting ---------- */
  function paintCurrency() {
    document.querySelectorAll('.rs-cur').forEach((el) => { el.textContent = state.cur; });
  }

  function paint() {
    const c = calc();
    $('rs-rev-out').textContent = fmt(c.rev);

    if (!state.unlocked) return;

    $('rs-w-in').textContent = fmt(c.rev);
    $('rs-w-tax').textContent = fmt(c.tax);
    $('rs-w-taxpct').textContent = (state.taxPct ?? 0) + '%';
    $('rs-w-run').textContent = fmt(c.run);
    $('rs-w-pay').textContent = fmt(c.payMonth);
    $('rs-w-payweek').textContent = fmt(c.payWeek);
    $('rs-w-buf').textContent = fmt(c.buffer);
  }

  /* ---------- the gate ----------
     The unlock form stays hidden until "Reset My Numbers" is clicked. Once
     unlocked (this visit or a past one), the results render straight away. */
  function paintGate() {
    $('rs-locked').hidden = !state.unlocked;
  }

  /* ---------- currency ---------- */
  document.querySelectorAll('[data-cur]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-cur]').forEach((b) => b.classList.remove('is-on'));
      btn.classList.add('is-on');
      state.cur = btn.getAttribute('data-cur') || '£';
      paintCurrency();
      paint();
    });
  });

  /* ---------- money in ---------- */
  $('rs-rev').addEventListener('input', (e) => {
    state.revenue = Number(e.target.value);
    paint();
  });

  /* ---------- work costs ---------- */
  const runChips = document.querySelectorAll('#rs-run-chips .rs-chip');
  const runCustomBox = $('rs-run-custom-box');
  const runCustomInput = $('rs-run-custom');
  runChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      runChips.forEach((c) => c.classList.remove('is-on'));
      chip.classList.add('is-on');
      const val = chip.getAttribute('data-val');
      if (val === 'custom') {
        runCustomBox.hidden = false;
        runCustomInput.focus();
        const v = Number(runCustomInput.value);
        state.runAmt = isFinite(v) ? Math.max(0, v) : 0;
      } else {
        runCustomBox.hidden = true;
        state.runAmt = Number(val);
      }
      paint();
    });
  });
  runCustomInput.addEventListener('input', () => {
    const v = Number(runCustomInput.value);
    state.runAmt = isFinite(v) ? Math.max(0, v) : 0;
    paint();
  });

  /* ---------- tax reserve ---------- */
  const taxChips = document.querySelectorAll('#rs-tax-chips .rs-chip');
  taxChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      taxChips.forEach((c) => c.classList.remove('is-on'));
      chip.classList.add('is-on');
      state.taxPct = Number(chip.getAttribute('data-val'));
      paint();
    });
  });

  /* ---------- reveal ---------- */
  $('rs-reveal-btn').addEventListener('click', () => {
    if (state.unlocked) {
      paint();
      $('rs-locked').hidden = false;
      $('rs-locked').scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }

    $('rs-unlock').hidden = false;
    $('rs-unlock').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* ---------- unlock ----------
     Mirrors the server list in netlify/functions/lead-magnet-subscribe.js. This is a
     courtesy check so people get told before a round trip; the function is the real one. */
  const BAD_DOMAINS = new Set([
    'mailinator.com', 'guerrillamail.com', 'guerrillamail.info', 'guerrillamail.biz',
    '10minutemail.com', '10minutemail.net', 'tempmail.com', 'temp-mail.org',
    'yopmail.com', 'throwaway.email', 'maildrop.cc', 'getnada.com', 'sharklasers.com',
    'mintemail.com', 'mohmal.com', 'fakeinbox.com', 'trashmail.com', 'mailcatch.com',
    'spamgourmet.com', 'dispostable.com', 'tempinbox.com', 'mailnesia.com',
    'discard.email', 'spambog.com', 'tempmailo.com', 'emailondeck.com',
    'example.com', 'test.com', 'asdf.com', 'a.com', 'b.com',
  ]);

  function checkEmail(raw) {
    const email = (raw || '').trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return { ok: false, msg: 'That email does not look right.' };
    if (email.length > 254) return { ok: false, msg: 'That email is too long.' };
    const domain = email.split('@')[1];
    if (BAD_DOMAINS.has(domain)) return { ok: false, msg: 'Use a real address, not a temporary one.' };
    return { ok: true, email };
  }

  function unlock() {
    state.unlocked = true;
    try { localStorage.setItem(UNLOCK_KEY, '1'); } catch (err) { /* nothing to do */ }
    paintGate();
    paint();
    $('rs-unlock').hidden = true;
    $('rs-locked').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  $('rs-unlock').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = $('rs-unlock-btn');
    const errEl = $('rs-unlock-err');
    const nameInput = $('rs-name');
    const emailInput = $('rs-email');

    const name = nameInput.value.trim();
    if (!name) { errEl.textContent = 'First name is required.'; nameInput.focus(); return; }

    const v = checkEmail(emailInput.value);
    if (!v.ok) { errEl.textContent = v.msg; emailInput.focus(); return; }

    errEl.textContent = '';
    btn.disabled = true;
    const label = btn.textContent;
    btn.textContent = 'One second…';

    try {
      const res = await fetch('/api/lead-magnet/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: v.email,
          name,
          magnet: 'cash-reset',
          honeypot: form.querySelector('[name="website"]').value || null,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        unlock();
        return;
      }
      // Say what actually went wrong rather than unlocking on a failure.
      errEl.textContent = data.error || 'That did not go through. Try again in a moment.';
    } catch (err) {
      errEl.textContent = 'No connection. Check your signal and try again.';
    }

    btn.disabled = false;
    btn.textContent = label;
  });

  /* ---------- copy ---------- */
  $('rs-copy').addEventListener('click', async () => {
    const c = calc();
    const cur = state.cur;

    const lines = [
      '--- MY MONEY RESET BREAKDOWN ---',
      '',
      'Money in:                 ' + cur + fmt(c.rev) + '/mo',
      '',
      'Taxes (untouchable):      ' + cur + fmt(c.tax) + '/mo (' + (state.taxPct ?? 0) + '% sweep)',
      'Work & studio bills:      ' + cur + fmt(c.run) + '/mo',
      'What’s mine to keep:      ' + cur + fmt(c.payMonth) + '/mo (' + cur + fmt(c.payWeek) + '/wk)',
      'Slow-month buffer:        ' + cur + fmt(c.buffer) + '/mo',
      '',
      'Ran via ' + TOOL_URL,
    ];

    const text = lines.join('\n');

    const note = $('rs-copied');
    try {
      await navigator.clipboard.writeText(text);
      note.textContent = '✓ Copied. Paste it straight into the DM.';
    } catch (err) {
      // Some in-app browsers block the clipboard. Say so rather than failing quietly.
      note.textContent = 'Your browser blocked the copy. Screenshot this page and send that instead.';
    }
  });

  paintGate();
  paintCurrency();
  paint();
</script>

<style is:global>
  /* ============================================================
     THE MONEY RESET TOOL · /reset
     Dark, to match the Money Story Diagnostic at discover.thewayofwealth.shop
     (src/styles.css, the .lp block). Same ground, same panels, same gold as the
     single accent, same Fraunces + Inter pairing. One brand, two tools.
  ============================================================ */

  /* The page owns its own ground. Scoped to this page's body class so the two
     other pages on this layout are untouched. */
  body.rs-dark {
    background: #0b1119;
    color: var(--d-text);
  }
  body.rs-dark main {
    background: radial-gradient(115% 60% at 78% -6%, #16212e 0%, #0b1119 55%, #070c12 100%);
  }
  /* This page has its own top bar and footer (rs-top / rs-foot below), matching
     the Money Story Diagnostic at discover.thewayofwealth.shop. The shared site
     header and footer are switched off here so there isn't a duplicate. */
  body.rs-dark .lp-header,
  body.rs-dark .lp-footer { display: none; }

  .rs-wrap {
    --d-bg: #0b1119;
    --d-panel: #131d29;
    --d-panel-2: #0e1721;
    --d-inset: #0d151f;
    --d-line: #26323f;
    --d-text: #F5F0E8;
    --d-mute: #9AA7B4;
    --d-gold: #C4A265;
    --d-on-gold: #14202c;
    --d-display: 'Fraunces', Georgia, serif;

    max-width: 1180px;
    margin: 0 auto;
    padding: 2rem 1.25rem 5rem;
    color: var(--d-text);
  }

  /* The gate depends on the hidden attribute actually hiding things. Any stray
     display rule would silently defeat it, so make it unbeatable. */
  .rs-wrap [hidden] { display: none !important; }

  .rs-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* --- top bar: photo + name + credentials left, wordmark right --- */
  .rs-top {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
    max-width: 1180px; margin: 0 auto clamp(2.2rem, 6vw, 4rem);
  }
  .rs-who { display: flex; align-items: center; gap: 0.75rem; }
  .rs-face { width: 46px; height: 46px; border-radius: 50%; object-fit: cover; border: 1px solid var(--d-line); }
  .rs-top .rs-name { font-family: var(--d-display); font-weight: 600; font-size: 1rem; margin: 0; color: var(--d-text); }
  .rs-top .rs-cred { margin: 1px 0 0; font-family: var(--font-ui); font-size: 0.76rem; color: var(--d-mute); line-height: 1.35; }
  .rs-mark { font-family: var(--d-display); font-size: 1.05rem; margin: 0; color: var(--d-text); }
  .rs-mark em { color: var(--d-gold); font-style: italic; }

  /* --- hero: copy left, calculator right --- */
  .rs-hero-grid {
    display: grid; grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(1.75rem, 5vw, 4.5rem); align-items: start;
    max-width: 1180px; margin: 0 auto;
  }
  .rs-copy { padding-top: 0.4rem; }
  .rs-panel { display: flex; flex-direction: column; gap: 1.1rem; }
  .rs-panel .rs-card,
  .rs-panel .rs-unlock { margin-bottom: 0; }

  /* --- everything after the hero stays at the narrower reading width --- */
  .rs-below { max-width: 820px; margin: 2.75rem auto 0; }

  .rs-badge {
    display: inline-block; font-family: var(--font-ui); font-size: 11.5px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--d-gold);
    background: rgba(196, 162, 101, 0.12); border: 1px solid rgba(196, 162, 101, 0.3);
    border-radius: 999px; padding: 0.4rem 0.9rem; margin-bottom: 1.4rem;
  }
  .rs-h1 {
    font-family: var(--d-display); font-weight: 600;
    font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.08; letter-spacing: -0.015em;
    color: #fff; margin: 0; text-wrap: balance;
  }
  .rs-h1 em { font-style: italic; color: var(--d-gold); }
  .rs-sub {
    font-family: var(--font-ui); font-size: clamp(0.98rem, 1.5vw, 1.08rem);
