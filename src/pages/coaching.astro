---
import Layout from '../layouts/Layout.astro';
import { LINKS } from '../config/links';
import { RESULT_CLIPS } from '../config/resultsClips';

const title = "The Money Story Method | 12-Week 1:1 Coaching | Way of Wealth";
const description = "A 12-week 1:1 programme for people who earn well but never feel like they keep it. Behavioural coaching, plus the money system built with you. MSc Behavioural Economics | Qualified Financial Planner.";

const VSL_SRC = 'https://discover.thewayofwealth.shop/vsl/vsl.mp4';
const VSL_POSTER = 'https://discover.thewayofwealth.shop/vsl/vsl-poster.jpg';

const PAIN_CARDS = [
  { n: '01', t: "\"What should I actually charge?\" Never really answered. You picked a number and hoped nobody would ask why." },
  { n: '02', t: "A flicker of guilt every time you charge good money for work that also means something to you." },
  { n: '03', t: "One account for everything. A £5,000 invoice lands and you spend money that was never yours." },
  { n: '04', t: "The tax bill arrives and there isn't enough in the account to pay it." },
  { n: '05', t: "You check your balance at 2am, or you don't check it at all." },
  { n: '06', t: "Good months disappear into gear and lifestyle. Quiet months arrive with nothing behind them." },
  { n: '07', t: "You've tried the apps, the budgets and the spreadsheets. None of them stuck." },
];

const CLIENT_QUOTES = [
  "It's almost like looking in a mirror.",
  "I feel seen and called out at the same time.",
  "I don't want to pay rent with my mental health.",
  "Eight months ago I was crippled. I was stuck. I didn't know how to get out of my debt.",
  "You've taken money off the pedestal. Now it's just a tool. I'm in control of it, not it in control of me.",
  "Permission. That one word defines my whole life.",
];

const INCLUDES = [
  { t: "12 weekly 1:1 sessions", d: "Every week it's just you and me, looking at your real accounts. Not theory." },
  { t: "The system, built with you", d: "We set up four accounts together: tax, running costs, your pay and your runway. Then we automate them." },
  { t: "A 90-day statement audit", d: "Your leak sheet sorts three months of statements in one sitting. Then we go through it together, so you see where it actually goes." },
  { t: "Weekly worksheets", d: "Short exercises in your own portal. They pull apart the beliefs sitting under the habits." },
  { t: "Support between sessions", d: "I'm a message away. That's usually when the wobble happens, so that's when the real work gets done." },
  { t: "You keep everything", d: "Recordings, worksheets, your plan. Lifetime portal access. It doesn't stop at week twelve." },
];

const PHASES = [
  {
    tab: "Weeks 1–3", name: "See it, then move it",
    body: [
      "We find your money script, the belief that's been running the show.",
      "You put 90 days of statements through your leak sheet, then we go through it together: what you guessed you spend against what you really spend.",
      "By week 3 the money moves. We set up the four accounts, tax, running costs, your pay and your buffer, and the standing orders that fill them.",
    ],
    quote: "It's almost like looking in a mirror.",
  },
  {
    tab: "Weeks 4–5", name: "Understand why",
    body: [
      "Week 4: we go deep on where your money story comes from and what money means to you. Your Money Story Profile follows as a document.",
      "Week 5: your Behavioural Pattern Report. Your patterns, with proof from your own spending.",
    ],
    quote: "I feel seen and called out at the same time.",
  },
  {
    tab: "Weeks 6–8", name: "Rewrite it",
    body: [
      "We pick the belief holding you back the most and challenge it.",
      "We rewrite it, in your own words.",
      "We set up guardrails for the moments you usually slip, and check the automation is holding.",
    ],
    quote: "You've taken money off the pedestal. Now it's just a tool. I'm in control of it, not it in control of me.",
  },
  {
    tab: "Weeks 9–12", name: "Aim it",
    body: [
      "We set goals against what you actually value, not what you think you should want.",
      "We map out your cash flow with the new system in place.",
      "We look back at how far you've come, then graduation. You leave with the plan, the system and the recordings.",
    ],
    quote: "Permission. That one word defines my whole life.",
  },
];



// Raw call clips only (max 2 per client, mixed order). Files in /public/testimonials/results/.
const VIDEOS = RESULT_CLIPS.map((c) => ({ slug: `results/${c.slug}`, cap: c.cap, who: c.who }));
const SHOW_FIRST = 9; // clips shown before the "See all" button; the rest load only when opened

// The three reasons clients actually gave on their calls (Fathom check, 2026-09-24).
const WINDOWS = [
  {
    tab: "The same loop", head: "It keeps happening, and you can't make it stop.",
    you: ["You've tried budgets and apps, and they never stick.", "You know what to do. You just don't do it.", "Every time you get ahead, something pulls you back."],
    we: "We find the belief running the loop. And by week 3 the money is already moving: pots, standing orders and a buffer.",
  },
  {
    tab: "Ready to build", head: "The money comes in. You want it to build something.",
    you: ["Money sits in your account and never turns into anything.", "You want a plan, not just a balance.", "You're curious why you handle money the way you do."],
    we: "We work out your real number, set up the system, then map out your cash flow so your money has a job and a direction.",
  },
  {
    tab: "Life just changed", head: "A move, a relationship, a new chapter. Money suddenly matters more.",
    you: ["Someone close has started asking about your spending.", "A big change is coming and you want to be ready for it.", "Your old habits don't fit the life you're building."],
    we: "We go through your last 90 days together, see what's really going on, and set up a system that fits the life you're moving into.",
  },
];

const PRICES = [
  { label: "Pay once", big: "£1,000", note: "one payment, no plan fee", perks: ["£1,000 in total", "Full programme access", "Everything included"] },
  { label: "Split in two", big: "£500", note: "× 2 monthly payments", perks: ["£1,000 in total", "First payment starts your access", "Same programme, same support"] },
  { label: "Lowest upfront", big: "£334", note: "× 3 monthly payments", perks: ["£1,002 in total", "First payment starts your access", "Same programme, same support"] },
];

const FAQS = [
  { q: "What happens on the free call?", a: "Twenty minutes on Zoom. No slides, no pressure. You tell me what's going on with your money and I tell you honestly whether this is the right fit. I read your application before we speak, so we don't waste the first ten minutes." },
  { q: "Is this financial advice?", a: "No. I'm a planner, not an adviser. I don't recommend products, returns or tax structures. I teach you the system and work on the behaviour underneath it. For tax or investment decisions, you'd still use your accountant or an adviser." },
  { q: "I already have an accountant.", a: "Good. An accountant looks backwards to keep you legal. They don't tell you how much of today's invoice you can actually move to your own account. That's the gap we work on." },
  { q: "My income is too up and down for a system.", a: "Honestly, it feels up and down because of how you take money out. Get a buffer in place and a big month pays for a small one." },
  { q: "I'll sort it out when I earn more.", a: "More revenue doesn't fix a leak. It scales it. The sooner the system is in, the more it protects." },
  { q: "Will this work for my kind of work?", a: "It's not really about the trade. It's about how the money arrives. If you sell sessions, day rates, packages or retainers, and it lands gross with nothing held back, this is built for you." },
  { q: "What if it isn't for me?", a: "That's what the Three-Session Promise is for. Full refund if it's not landing by session 3." },
  { q: "Do I keep the material?", a: "Yes. Recordings, worksheets and your plan are yours, with lifetime portal access." },
  { q: "How do I pay?", a: "You can pay in full, in two monthly payments or in three. We agree the plan on the call." },
];
---
<Layout title={title} description={description} canonical={`${LINKS.siteUrl}/coaching`}>

<!-- 1 · HERO -->
<section class="sp-hero" id="top">
  <div class="sp-hero-inner">
    <div class="sp-hero-copy reveal">
      <p class="sp-eyebrow">The Money Story Method · 12-week 1:1 programme</p>
      <h1>End the anxiety around money, stop quitting every budget, <em>and build wealth that actually fits how you think.</em></h1>
      <p class="sp-lead">This is for you if you earn well and still feel like you never keep any of it. Twelve weeks, one to one. We build your money system together, on the call.</p>
      <div class="sp-cta-row">
        <a href="#apply" class="sp-btn sp-btn-gold">Book your free 20-minute call</a>
        <a href="#how" class="sp-link">See how the 12 weeks work ↓</a>
      </div>
      <p class="sp-creds"><b>Joel Ezekiel</b> · MSc Behavioural Economics | Qualified Financial Planner</p>
    </div>
    <div class="sp-hero-video reveal">
      <video controls playsinline preload="metadata" poster={VSL_POSTER} src={VSL_SRC}></video>
    </div>
  </div>
</section>

<!-- 2 · CREDENTIALS STRIP -->
<section class="sp-strip">
  <p class="sp-strip-label">Trained in · grounded in</p>
  <ul class="sp-strip-row">
    <li>MSc Behavioural Economics</li>
    <li>Qualified Financial Planner (UK)</li>
    <li>Klontz Money Scripts</li>
    <li>Kahneman · Thaler · Duhigg</li>
    <li>Ex St. James's Place</li>
  </ul>
</section>

<!-- 3 · EMPATHY -->
<section class="sp-section sp-cream">
  <svg class="sp-wave" style="--wave-fill: var(--color-bg-white);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,30 C1200,90 960,0 720,40 C480,80 240,0 0,50 Z"/></svg>
  <div class="sp-narrow reveal">
    <h2 class="sp-h2">You invoiced well this month.<br /><em>So why do you feel broke?</em></h2>
    <p>You know that feeling, right?</p>
    <p>The invoice lands. The balance looks huge. You feel great for like a day.</p>
    <p>Then the tax, the software, the rent and the shopping all come out of the same pot. Your accountant says it was a great year. Your savings account says something totally different.</p>
    <blockquote class="sp-pull">"Xero tells me I had an £80k year, but my personal savings account has £4,200 in it. Where on earth did all that cash actually go?"<cite>Self-employed professional, in their own words</cite></blockquote>
    <p>And then it's nine at night. You've been making decisions for ten hours and you're tired, so you take the easiest option. And the easiest option is the app that already has your card.</p>
    <p class="sp-strong">That's not a willpower thing, and it's not a maths thing. It's just how your money moves.</p>
  </div>
</section>

<!-- 4 · THE TURN -->
<section class="sp-section sp-white">
  <div class="sp-narrow reveal">
    <h2 class="sp-h2">Working harder won't fix this.<br /><em>Changing where the money goes will.</em></h2>
    <p>Earning more doesn't fix a leak. It just makes the leak bigger.</p>
    <p>The people who seem calm about money aren't more disciplined than you. They've just set things up so the easy thing is also the right thing. So they don't need willpower.</p>
    <p>That's what we build together, so it keeps working when you're tired and can't be bothered.</p>
  </div>
</section>

<!-- 5 · PAIN CARDS -->
<section class="sp-section sp-navy">
  <svg class="sp-wave" style="--wave-fill: var(--color-bg-white);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,50 C1200,0 960,90 720,40 C480,0 240,80 0,30 Z"/></svg>
  <div class="sp-wide">
    <h2 class="sp-h2 sp-on-dark reveal">Which of these do you<br /><em>know too well?</em></h2>
    <ul class="sp-pain-grid">
      {PAIN_CARDS.map((c) => (
        <li class="sp-pain reveal"><span class="sp-pain-n">{c.n}</span><p>{c.t}</p></li>
      ))}
    </ul>
    <p class="sp-on-dark sp-center sp-after">This happens at every income level. More money isn't the fix, right? It's how the money moves.</p>
  </div>
</section>

<!-- 6 · RING A BELL -->
<section class="sp-section sp-white">
  <svg class="sp-wave" style="--wave-fill: var(--color-navy-deep);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,40 C1200,90 960,10 720,50 C480,90 240,10 0,55 Z"/></svg>
  <div class="sp-narrow reveal">
    <div>
      <h2 class="sp-h2">Do any of these<br /><em>ring a bell?</em></h2>
      <ul class="sp-tick">
        <li>You know you should set money aside for tax, but it never quite happens.</li>
        <li>You avoid your statements until you have to open them.</li>
        <li>You can't say what you can safely take out this month.</li>
        <li>You've started a budget more than once and quit.</li>
        <li>You feel guilty spending on yourself, or charging what you're worth.</li>
        <li>You want to feel calm about money, not just "good at it".</li>
      </ul>
      <p class="sp-strong">If two or three of those hit home, you're in the right place.</p>
    </div>
  </div>
</section>

<!-- 8 · FOUNDER -->
<section class="sp-section sp-white">
  <div class="sp-wide sp-founder reveal" id="origin">
    <figure class="sp-portrait">
      <img src="/images/joel-headshot-web.jpg" alt="Joel Ezekiel" loading="lazy" />
    </figure>
    <div>
      <h2 class="sp-h2">Hi, I'm <em>Joel.</em></h2>
      <p>I turned £3,000 into £150,000 trading. I thought I was a genius. Then I lost all of it.</p>
      <p>I didn't even have a degree back then. That's what sent me off to go and study this properly.</p>
      <p>So now I've got an MSc in Behavioural Economics and I'm a Qualified Financial Planner. And honestly, what I found is that the plan is almost never the problem. Smart people sign a good plan and still don't follow it. It's the beliefs and habits underneath, you know, the stuff running on autopilot.</p>
      <p>The Money Story Method is what I built for that. We work on those beliefs, and we build the system together, on the call.</p>
      <ul class="sp-tick sp-tick-tight">
        <li>MSc Behavioural Economics</li>
        <li>Qualified Financial Planner (UK)</li>
        <li>A planner, not an adviser. I show you how the system works. I don't tell you what to buy.</li>
      </ul>
    </div>
  </div>
</section>

<!-- 9 · WHAT CHANGES + QUOTES -->
<section class="sp-section sp-navy">
  <svg class="sp-wave" style="--wave-fill: var(--color-bg-white);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,50 C1200,0 960,90 720,40 C480,0 240,80 0,30 Z"/></svg>
  <div class="sp-wide">
    <div class="sp-narrow sp-center reveal">
      <h2 class="sp-h2 sp-on-dark">What changes when the<br /><em>system does the work.</em></h2>
      <p class="sp-on-dark">Picture opening your bank app and just knowing what's yours. The tax is already put away. You pay yourself on the same day every month. And a quiet month? It's just a quiet month.</p>
    </div>
    <ul class="sp-quote-row">
      {CLIENT_QUOTES.slice(0, 3).map((q) => (
        <li class="sp-qcard reveal"><span class="sp-qmark" aria-hidden="true">“</span><p>{q}</p><small>Money Story Method client, in their own words</small></li>
      ))}
    </ul>
  </div>
</section>

<!-- 10 · INTRODUCING + INCLUDES -->
<section class="sp-section sp-white">
  <svg class="sp-wave" style="--wave-fill: var(--color-navy-deep);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,40 C1200,90 960,10 720,50 C480,90 240,10 0,55 Z"/></svg>
  <div class="sp-wide">
    <div class="sp-narrow sp-center reveal">
      <span class="sp-badge">Introducing</span>
      <h2 class="sp-h2">The Money Story <em>Method</em></h2>
      <p>Twelve weeks, one to one, just you and me. We change the habits and we build the system, on the call. It's not a course, it's not a community and it's not a PDF.</p>
    </div>
    <h3 class="sp-h3 sp-center reveal">Here's what's included</h3>
    <ul class="sp-include-grid">
      {INCLUDES.map((c) => (
        <li class="sp-include reveal"><h4>{c.t}</h4><p>{c.d}</p></li>
      ))}
    </ul>
    <div class="sp-center sp-after"><a href="#apply" class="sp-btn sp-btn-gold">Book your free 20-minute call</a></div>
  </div>
</section>

<!-- 11 · 12-WEEK TABS -->
<section class="sp-section sp-cream" id="how">
  <div class="sp-wide">
    <h2 class="sp-h2 sp-center reveal">How the 12 weeks<br /><em>actually work.</em></h2>
    <div class="sp-tabs" data-tabs>
      <div class="sp-tablist" role="tablist">
        {PHASES.map((p, i) => (
          <button role="tab" class={`sp-tab${i === 0 ? ' active' : ''}`} aria-selected={i === 0 ? 'true' : 'false'} data-i={i}><small>{p.tab}</small><span>{p.name}</span></button>
        ))}
      </div>
      {PHASES.map((p, i) => (
        <div class={`sp-panel${i === 0 ? ' active' : ''}`} role="tabpanel" data-i={i}>
          <div class="sp-panel-head"><small>{p.tab}</small><h3>{p.name}</h3></div>
          <div class="sp-panel-body">
            <ul class="sp-tick sp-tick-tight">
              {p.body.map((b) => <li>{b}</li>)}
            </ul>
            <blockquote class="sp-panel-quote">"{p.quote}"<cite>Money Story Method client</cite></blockquote>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 12 · VIDEO WALL -->
<section class="sp-section sp-navy" id="results">
  <svg class="sp-wave" style="--wave-fill: var(--color-cream);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,50 C1200,0 960,90 720,40 C480,0 240,80 0,30 Z"/></svg>
  <div class="sp-wide">
    <h2 class="sp-h2 sp-on-dark sp-center reveal">Wondering what<br /><em>results look like?</em></h2>
    <p class="sp-on-dark sp-center sp-sub reveal">Hear it from people who were exactly where you are.</p>
    <figure class="sp-vfeature reveal">
      <video controls playsinline preload="none" poster={`/testimonials/${VIDEOS[0].slug}.jpg`} src={`/testimonials/${VIDEOS[0].slug}.mp4`}></video>
      <figcaption>
        <p>"{VIDEOS[0].cap}"</p>
        <small>{VIDEOS[0].who} · came in stuck in debt, left debt-free and on a five-year plan</small>
      </figcaption>
    </figure>
    <div class="sp-video-grid">
      {VIDEOS.slice(1).map((v, i) => (
        <figure class="sp-vcard reveal" data-extra={i >= SHOW_FIRST ? "1" : undefined} hidden={i >= SHOW_FIRST}>
          <video controls playsinline preload="none" poster={`/testimonials/${v.slug}.jpg`} src={`/testimonials/${v.slug}.mp4`}></video>
          <figcaption><p>{v.cap}</p><small>{v.who}</small></figcaption>
        </figure>
      ))}
    </div>
    {VIDEOS.length - 1 > SHOW_FIRST && (
      <div class="sp-center sp-more-wrap">
        <button type="button" id="sp-more" class="sp-btn sp-btn-gold">See all {VIDEOS.length} client clips</button>
      </div>
    )}
  </div>
</section>
<script>
  const btn = document.getElementById('sp-more');
  if (btn) {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.sp-vcard[data-extra]').forEach((el) => el.removeAttribute('hidden'));
      btn.parentElement?.remove();
    });
  }
</script>

<!-- 13 · WHICH ONE IS YOU (tabs) -->
<section class="sp-section sp-white">
  <svg class="sp-wave" style="--wave-fill: var(--color-navy-deep);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,40 C1200,90 960,10 720,50 C480,90 240,10 0,55 Z"/></svg>
  <div class="sp-wide">
    <h2 class="sp-h2 sp-center reveal">Most people reach out<br /><em>for one of three reasons.</em></h2>
    <p class="sp-center sp-sub reveal">Which one is closest to yours?</p>
    <div class="sp-tabs" data-tabs>
      <div class="sp-tablist sp-tablist-3" role="tablist">
        {WINDOWS.map((w, i) => (
          <button role="tab" class={`sp-tab${i === 0 ? ' active' : ''}`} aria-selected={i === 0 ? 'true' : 'false'} data-i={i}><span>{w.tab}</span></button>
        ))}
      </div>
      {WINDOWS.map((w, i) => (
        <div class={`sp-panel${i === 0 ? ' active' : ''}`} role="tabpanel" data-i={i}>
          <div class="sp-panel-head"><small>This might be you</small><h3>{w.head}</h3></div>
          <div class="sp-panel-body">
            <div>
              <p class="sp-mini">This is you if:</p>
              <ul class="sp-tick sp-tick-tight">{w.you.map((y) => <li>{y}</li>)}</ul>
            </div>
            <div class="sp-we"><p class="sp-mini">What we'd do:</p><p>{w.we}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 14 · WHAT'S IT WORTH -->
<section class="sp-section sp-cream">
  <div class="sp-narrow reveal">
    <h2 class="sp-h2">What would it be worth<br /><em>to feel calm about money?</em></h2>
    <p>Picture a normal Tuesday.</p>
    <ul class="sp-tick">
      <li>You open your banking app and you know what's yours.</li>
      <li>The tax is already set aside. No dread when the bill comes.</li>
      <li>A quiet month is a quiet month, not a crisis.</li>
      <li>You charge what the work is worth, without the flinch.</li>
      <li>You stop thinking about money at 2am.</li>
    </ul>
    <p class="sp-strong">That's it. That's what the twelve weeks are for.</p>
  </div>
</section>

<!-- 15 · PRICING -->
<section class="sp-section sp-navy" id="price">
  <svg class="sp-wave" style="--wave-fill: var(--color-cream);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,50 C1200,0 960,90 720,40 C480,0 240,80 0,30 Z"/></svg>
  <div class="sp-wide">
    <h2 class="sp-h2 sp-on-dark sp-center reveal">Choose how you'd like<br /><em>to pay.</em></h2>
    <p class="sp-on-dark sp-center sp-sub reveal">Same programme, same support. We agree the plan on the call. I take on 5 people a month.</p>
    <ul class="sp-price-grid">
      {PRICES.map((p) => (
        <li class="sp-price reveal">
          <span class="sp-price-label">{p.label}</span>
          <div class="sp-price-big">{p.big}</div>
          <p class="sp-price-note">{p.note}</p>
          <ul>{p.perks.map((x) => <li>{x}</li>)}</ul>
          <a href="#apply" class="sp-btn sp-btn-gold">Book a free call</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- 16 · GUARANTEE -->
<section class="sp-section sp-white">
  <svg class="sp-wave" style="--wave-fill: var(--color-navy-deep);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,40 C1200,90 960,10 720,50 C480,90 240,10 0,55 Z"/></svg>
  <div class="sp-narrow sp-center reveal">
    <div class="sp-seal" aria-hidden="true">3</div>
    <h2 class="sp-h2">The Three-Session <em>Promise</em></h2>
    <p class="sp-strong">Full refund if it's not landing by session 3.</p>
    <p>I want you to feel good about this. If the work isn't landing for you by session 3, you get all of your money back.</p>
  </div>
</section>

<!-- 17 · FAQ -->
<section class="sp-section sp-cream" id="faq">
  <div class="sp-narrow">
    <h2 class="sp-h2 sp-center reveal">Commonly asked <em>questions</em></h2>
    <div class="sp-faq reveal">
      {FAQS.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </div>
</section>

<!-- 18 · CLOSING + APPLY -->
<section class="g-apply sp-apply" id="apply">
