---
import Layout from '../layouts/Layout.astro';
import { LINKS } from '../config/links';

const title = "The Money Story Method — 12-Week Behavioural Coaching Programme | Way of Wealth";
const description = "A 1:1 coaching programme for self-developed people who earn well but don't build wealth. MSc Behavioural Economics. Qualified Financial Planner. Founding cohort: £997.";

const FOUNDING_SPOTS_REMAINING = 5;
const VSL_YOUTUBE_ID = ''; // Set to 11-char YouTube ID when VSL is recorded.

// Cohort initials (privacy: cohort 1 in flight, names anonymised)
const COHORT_INITIALS = ['A', 'J', 'S', 'R', 'M'];

// Cohort testimonials — verbatim, anonymised, dated.
const TESTIMONIALS = [
  { quote: "Exactly what people do with their fitness, I'm doing with my money.", session: "session 1", role: "Personal trainer · UK", initial: "A" },
  { quote: "It's almost like looking in a mirror.", session: "session 1", role: "Personal trainer · UK", initial: "A" },
  { quote: "It's kind of financial psychology — it's a different lens of looking at the finances.", session: "session 2", role: "Consultant · UK", initial: "S" },
  { quote: "I needed to learn to love myself without having a minimum of 10K in my bank account at a time.", session: "session 1", role: "Healing practitioner · US", initial: "J" },
  { quote: "It's no longer a fear of, oh, I don't want to check my account. Now you're in full control of that as well.", session: "session 4", role: "Personal trainer · UK", initial: "A" },
  { quote: "Eight years of solid everyday stress — money was the only thing I thought about. Now I'm thinking about, like, I'm going to open a studio.", session: "session 1", role: "Yacht chef · at sea", initial: "J" },
];
---
<Layout title={title} description={description} canonical={`${LINKS.siteUrl}/coaching`}>

<!-- ============================================================
     1 · HERO  (Genflow pattern: centered, MASSIVE type, single focus)
============================================================ -->
<section class="g-hero">
  <div class="g-hero-inner reveal">
    <p class="g-tagline">If any of this sounds like you</p>
    <h1 class="g-hero-h1">
      End the anxiety around money, stop quitting every budget, <em>and build wealth that actually fits how you think.</em>
    </h1>
    <ul class="g-hero-pains">
      <li>You're earning well and you have nothing to show for it.</li>
      <li>You've tried every app, every budget, every spreadsheet. None of them stuck.</li>
      <li>You can quote the books. You still avoid the bank app.</li>
      <li>You sabotage yourself every time you get close to a real money decision.</li>
      <li>You've worked on every other area of your life. Money is the one you can't seem to crack.</li>
    </ul>
    <p class="g-hero-creds">
      I know exactly what you're going through.
    </p>
    <p class="g-hero-bio">
      I'm Joel. I trained in behavioural economics at MSc level and in financial planning at Level 4 in the UK. I spent years at St. James's Place watching smart, disciplined people sign a sound plan and still not follow it. I built the Money Story Method to fix the part the plan can't — the script underneath. Let me help you close that gap.
    </p>
    <a href="#video" class="g-step-cta">
      <span class="g-step-num">Step 1 of 2</span>
      <span class="g-step-label">Watch the four-minute explainer ↓</span>
    </a>
  </div>
</section>

<!-- ============================================================
     2 · VIDEO  (Genflow's hero-anchor: VSL embed under the headline)
============================================================ -->
<section class="g-video" id="video">
  <div class="g-video-inner reveal">
    {VSL_YOUTUBE_ID ? (
      <div class="g-video-embed">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${VSL_YOUTUBE_ID}?rel=0`}
          title="The Money Story Method — 4-minute explainer"
          loading="lazy"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        />
      </div>
    ) : (
      <div class="g-video-placeholder">
        <div class="g-video-play" aria-hidden="true">
          <svg viewBox="0 0 80 80" width="80" height="80" fill="none">
            <circle cx="40" cy="40" r="38" stroke="currentColor" stroke-width="1.5" />
            <path d="M32 26 L56 40 L32 54 Z" fill="currentColor" />
          </svg>
        </div>
        <p class="g-video-tag">Four-minute explainer · coming soon</p>
        <p class="g-video-sub">In the meantime, jump to <a href="#step2">Step 2</a> — apply to work with me 1-1.</p>
      </div>
    )}
  </div>
</section>

<!-- ============================================================
     3 · STEP 2 OF 2  (Genflow's "Apply to work with us" centered block)
============================================================ -->
<section class="g-step2" id="step2">
  <div class="g-step2-inner reveal">
    <p class="g-step-eyebrow">Step 2 of 2 · Apply to work with me</p>
    <h2 class="g-step2-h2">
      If any of that sounds like you,<br />
      <em>this is what we'd actually do.</em>
    </h2>
    <ul class="g-step2-list">
      <li>Weeks 1–4, we map your money scripts. The four beliefs running underneath every financial decision you make. Most people are running two at once and don't know it.</li>
      <li>Weeks 4–8, we trace the inheritance. Whose pattern you're actually running. Usually a parent's, often older than that. Once you see it, you can stop carrying it.</li>
      <li>Weeks 8–12, we build the system. Behavioural cashflow architecture you'll actually use. A real financial plan, built around your psychology, not someone else's textbook.</li>
      <li>Between sessions, I'm at the end of a message. The moments behaviour wobbles are usually where the real work happens.</li>
      <li>You keep everything. Recordings, worksheets, Behavioural Financial Plan. The work doesn't stop when the twelve weeks do.</li>
    </ul>
    <a href="#apply" class="g-step-cta g-step-cta-primary">
      <span class="g-step-num">Step 2 of 2</span>
      <span class="g-step-label">Apply for the founding cohort →</span>
    </a>
    <p class="g-step2-spots">{FOUNDING_SPOTS_REMAINING} founding-cohort spots · £997 (rises to £1,997 after this cohort)</p>
  </div>
</section>

<!-- ============================================================
     4 · CREDENTIALS STRIP  (Genflow's small logo bar — subtle)
============================================================ -->
<section class="g-strip">
  <div class="g-strip-inner reveal">
    <p class="g-strip-label">Trained in · grounded in · regulated by</p>
    <ul class="g-strip-row">
      <li>MSc Behavioural Economics</li>
      <li>Level 4 QFP (UK)</li>
      <li>Klontz Money Scripts</li>
      <li>Kahneman · Thaler · Duhigg</li>
      <li>Ex St. James's Place</li>
    </ul>
  </div>
</section>

<!-- ============================================================
     5 · COHORT TESTIMONIALS  (Genflow's "founders I've worked with" grid)
============================================================ -->
<section class="g-testimonials">
  <div class="g-testimonials-inner">
    <h2 class="g-testimonials-h2 reveal">
      What they actually say<br />
      <em>once we get going.</em>
    </h2>
    <p class="g-testimonials-sub reveal">All of these are real things real clients said in session. I changed their names. I didn't change a word of what they said.</p>
    <ul class="g-testimonial-grid reveal">
      {TESTIMONIALS.map((t) => (
        <li class="g-testimonial-card">
          <div class="g-testimonial-avatar" aria-hidden="true">
            <span>{t.initial}</span>
          </div>
          <span class="g-testimonial-mark" aria-hidden="true">&ldquo;</span>
          <blockquote>{t.quote}</blockquote>
          <div class="g-testimonial-attr">
            <p class="g-testimonial-role">{t.role}</p>
            <p class="g-testimonial-session">{t.session}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============================================================
     6 · APPLY  (Final CTA: form + Calendly auto-reveal)
============================================================ -->
<section class="g-apply" id="apply">
  <div class="g-apply-inner">
    <p class="g-step-eyebrow reveal">Apply for the founding cohort</p>
    <h2 class="g-apply-h2 reveal">
      Tell me where you're at.<br /><em>Then we'll book the call.</em>
    </h2>
    <p class="g-apply-sub reveal">Two short forms on the same page. You write a few sentences about what's actually going on. You pick a time. I read your application before we speak, so we don't waste the first ten minutes on what.</p>

    <div id="calendly-step" class="calendly-step" style="display:none;">
      <div class="calendly-confirm">
        <p class="calendly-tick">✓</p>
        <h3>Got it. Now let's book the call.</h3>
        <p>Pick a time below — you'll get a calendar invite with the Zoom link straight away.</p>
      </div>
      <div id="calendly-embed" class="calendly-inline-widget" style="min-width:320px;height:720px;"></div>
    </div>

    <form id="apply-form" class="g-apply-form reveal">
      <div class="form-row">
        <label><span>Your name *</span><input type="text" name="name" required autocomplete="name" /></label>
      </div>
      <div class="form-row">
        <label><span>Email *</span><input type="email" name="email" required autocomplete="email" /></label>
      </div>
      <div class="form-row">
        <label><span>Phone (optional)</span><input type="tel" name="phone" autocomplete="tel" /></label>
      </div>
      <div class="form-row">
        <label><span>Where did you hear about Way of Wealth?</span>
          <select name="source">
            <option value="">— Pick one —</option>
            <option>Instagram</option>
            <option>TikTok</option>
            <option>Facebook</option>
            <option>Google search</option>
            <option>Referral from a friend / client</option>
            <option>Blog / article</option>
            <option>Podcast</option>
            <option>Other</option>
          </select>
        </label>
      </div>
      <div class="form-row">
        <label><span>What's your biggest money challenge right now? *</span>
          <textarea name="challenge" rows="4" required placeholder="Be as honest as you can — this helps me prepare for our discovery call."></textarea>
        </label>
      </div>
      <div class="form-row">
        <label><span>What have you already tried?</span>
          <textarea name="tried" rows="3" placeholder="Apps, budgets, books, other coaching — whatever's relevant."></textarea>
        </label>
      </div>
      <div class="form-row">
        <label><span>Why now?</span>
          <textarea name="whynow" rows="3" placeholder="What's happening that's making you ready for this?"></textarea>
        </label>
      </div>
      <div class="honeypot" aria-hidden="true">
        <label>Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <button type="submit" class="g-submit btn-submit">Submit application →</button>
      <p class="g-form-reassure">£997 founding rate confirmed on the call. Three-Session Promise: full refund if it's not landing by session 3. Your details stay private.</p>
      <div id="form-status" class="form-status" aria-live="polite"></div>
    </form>
  </div>
</section>

</Layout>

<script is:inline define:vars={{ apiUrl: LINKS.portalApplyApi }}>
  const CALENDLY_URL = 'https://calendly.com/thewayofwealth-official/20min';

  (function () {
    const form = document.getElementById('apply-form');
    const status = document.getElementById('form-status');
    const calendlyStep = document.getElementById('calendly-step');
    const calendlyEmbed = document.getElementById('calendly-embed');
    if (!form || !status || !calendlyStep || !calendlyEmbed) return;

    function loadCalendly() {
      if (!document.querySelector('link[href*="calendly.com/assets/external/widget.css"]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://assets.calendly.com/assets/external/widget.css';
        document.head.appendChild(link);
      }
      if (!document.querySelector('script[src*="calendly.com/assets/external/widget.js"]')) {
        const s = document.createElement('script');
        s.src = 'https://assets.calendly.com/assets/external/widget.js';
        s.async = true;
        document.body.appendChild(s);
      }
    }

    function showCalendly(name, email) {
      const params = new URLSearchParams();
      if (name) params.set('name', name);
      if (email) params.set('email', email);
      const urlWithPrefill = params.toString() ? `${CALENDLY_URL}?${params.toString()}` : CALENDLY_URL;
      calendlyEmbed.setAttribute('data-url', urlWithPrefill);
      form.style.display = 'none';
      calendlyStep.style.display = 'block';
      loadCalendly();
      setTimeout(() => calendlyStep.scrollIntoView({ behavior: 'smooth', block: 'start' }), 150);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'form-status loading';
      status.textContent = 'Sending...';
      const formData = new FormData(form);
      const name = formData.get('name');
      const email = formData.get('email');
      const payload = {
        name, email,
        phone: formData.get('phone') || null,
        source: formData.get('source') || null,
        challenge: formData.get('challenge') || null,
        tried: formData.get('tried') || null,
        whynow: formData.get('whynow') || null,
        honeypot: formData.get('website') || null,
      };
      try {
        const res = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) {
          status.className = 'form-status error';
          status.textContent = data.error || 'Something went wrong. Please email joel@thewayofwealth.shop directly.';
          return;
        }
        status.className = 'form-status';
        status.textContent = '';
        showCalendly(name, email);
      } catch {
        status.className = 'form-status error';
        status.textContent = 'Could not submit. Please email joel@thewayofwealth.shop and I will reply directly.';
      }
    });
  })();
</script>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&display=swap');

/* =================================================================
   COACHING PAGE — pairing researched for WoW palette (cream/navy/gold).
   Display headings → Fraunces (variable serif, opsz 144 for display,
     SOFT 50 for the warm rounded edge that complements cream).
   Body, bullets, UI, CTAs → Inter Tight (kept; pairs with serif).
   Layout follows Genflow structure (centered, 100vh hero, step1/step2
     spine, single-focus sections).
   ================================================================= */

/* --- Section base --- */
.g-hero, .g-video, .g-step2, .g-strip, .g-testimonials, .g-apply {
  padding: 9rem 1.5rem;
  position: relative;
}
.g-hero { padding: 11rem 1.5rem 7rem; }
.g-strip { padding: 4.5rem 1.5rem; }

/* =================================================================
   FONT SYSTEM — Inter Tight everywhere, matching Genflow exactly.
   Genflow specs (from Playwright):
     h1: 700 weight, 64px, line-height 1.0
     body: 400 weight, 18px, line-height 1.4
     ctas: 500 weight, 18px
     micro-tags: 400, 12-15px
   ================================================================= */
/* All body / UI / bullets / forms / CTAs in Inter Tight */
.g-hero, .g-hero *,
.g-video, .g-video *,
.g-step2, .g-step2 *,
.g-strip, .g-strip *,
.g-testimonials, .g-testimonials *,
.g-apply, .g-apply * {
  font-family: 'Inter Tight', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
}
/* Display headings (upright) → Fraunces SOFT 50, opsz 144 (warm display) */
.g-hero-h1,
.g-step2-h2,
.g-testimonials-h2,
.g-apply-h2 {
  font-family: 'Fraunces', 'Source Serif 4', Georgia, serif !important;
  font-variation-settings: "opsz" 144, "SOFT" 50, "WONK" 0;
}
/* Italic gold accent (italic em) → SHARPER serifs (SOFT 0) + lighter weight 500.
   Was reading bubbly + thick at SOFT 50 / weight 700. */
.g-hero-h1 em,
.g-step2-h2 em,
.g-testimonials-h2 em,
.g-apply-h2 em,
.g-hero-creds {
  font-family: 'Fraunces', 'Source Serif 4', Georgia, serif !important;
  font-variation-settings: "opsz" 144, "SOFT" 0, "WONK" 0;
  font-weight: 500;
  font-style: italic;
}

/* =================================================================
   DARK THEME — every section matches the navy-deep video band.
   Drops gold from headline italics (replaced with cream).
   Gold is reserved for CTAs + tiny accents.
   ================================================================= */
.g-hero,
.g-step2,
.g-strip,
.g-testimonials,
.g-apply {
  background: var(--color-navy-deep) !important;
  border-color: rgba(245,240,232,0.10) !important;
}
.g-hero::before, .g-apply::before {
  background:
    radial-gradient(circle at 70% 20%, rgba(196,162,101,0.10), transparent 55%),
    radial-gradient(circle at 20% 90%, rgba(196,162,101,0.04), transparent 55%) !important;
}

/* Main headline → cream */
.g-hero-h1,
.g-step2-h2,
.g-testimonials-h2,
.g-apply-h2 {
  color: var(--color-cream) !important;
}
/* Italic accent line → gold (the one warm pop on the page) */
.g-hero-h1 em,
.g-step2-h2 em,
.g-testimonials-h2 em,
.g-apply-h2 em {
  color: var(--color-gold) !important;
}

/* Body / bullets / bio / sub-copy → soft cream */
.g-hero-pains li,
.g-hero-bio,
.g-step2-list li,
.g-testimonials-sub,
.g-apply-sub {
  color: rgba(245,240,232,0.82) !important;
}
.g-hero-bio strong { color: var(--color-cream) !important; }

/* The bridge line "I know exactly what you're going through" — keep as the one warm accent */
.g-hero-creds { color: var(--color-gold) !important; }

/* Dashed bullet dividers — flip to soft cream on dark */
.g-hero-pains li:not(:last-child),
.g-step2-list li {
  border-bottom-color: rgba(245,240,232,0.15) !important;
}

/* Eyebrows / pills / tags */
.g-tagline {
  background: rgba(245,240,232,0.08) !important;
  border-color: rgba(245,240,232,0.18) !important;
  color: var(--color-cream) !important;
}
.g-step-eyebrow {
  background: rgba(245,240,232,0.06) !important;
  border-color: rgba(245,240,232,0.18) !important;
  color: var(--color-cream) !important;
}
.g-step2-spots { color: rgba(245,240,232,0.6) !important; }

/* Credentials strip */
.g-strip-label { color: rgba(245,240,232,0.55) !important; }
.g-strip-row li { color: var(--color-cream) !important; }

/* Testimonial cards — slightly lighter on dark */
.g-testimonial-card {
  background: rgba(245,240,232,0.04) !important;
  border-color: rgba(245,240,232,0.12) !important;
}
.g-testimonial-card blockquote { color: var(--color-cream) !important; }
.g-testimonial-role { color: var(--color-cream) !important; }
.g-testimonial-session { color: rgba(245,240,232,0.55) !important; }
.g-testimonial-attr { border-top-color: rgba(245,240,232,0.12) !important; }
.g-testimonial-mark { color: var(--color-gold); opacity: 0.4; }

/* Step 1 CTA — invert: cream button on dark */
.g-step-cta {
  background: var(--color-cream) !important;
  color: var(--color-navy) !important;
  border-color: var(--color-cream) !important;
}
.g-step-cta:hover {
  background: #fff !important;
  border-color: #fff !important;
}
/* Step 2 CTA stays gold (primary) */

/* Apply form section — form card stays light for input contrast */
.g-apply-form {
  background: var(--color-cream) !important;
  border-color: rgba(196,162,101,0.30) !important;
}
.g-form-reassure { color: var(--color-slate) !important; }

/* =================================================================
   1 · HERO  (Genflow: claims full viewport, massive type, centered)
   ================================================================= */
.g-hero {
  background: var(--color-bg-white);
  text-align: center;
  border-bottom: 1px solid var(--color-border-warm);
  min-height: 100vh;
  min-height: 100svh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rem 1.5rem 6rem;
}
.g-hero::before {
  content: "";
  position: absolute; inset: 0;
  background:
    radial-gradient(circle at 70% 20%, rgba(196,162,101,0.10), transparent 55%),
    radial-gradient(circle at 20% 90%, rgba(28,42,58,0.04), transparent 55%);
  pointer-events: none;
}
.g-hero-inner {
  max-width: 1080px;
  margin: 0 auto;
  position: relative;
  width: 100%;
}
/* Tag pill — Genflow style: white pill with dark text, small */
.g-tagline {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--color-navy);
  background: #fff;
  border: 1px solid var(--color-border-warm);
  border-radius: 999px;
  padding: 6px 24px;
  display: inline-block;
  margin: 0 0 2.4rem;
}
/* Hero H1 — Genflow exact: 64px, weight 700, line-height 1.0 */
.g-hero-h1 {
  font-size: clamp(2.4rem, 5vw, 4rem);
  font-weight: 700;
  line-height: 1.0;
  color: var(--color-navy);
  margin: 0 0 2rem;
  letter-spacing: -0.015em;
  max-width: 1100px;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 2rem;
}
.g-hero-h1 em {
  color: var(--color-gold);
  font-weight: 500;
  display: block;
  margin-top: 0.5rem;
}
.g-hero-pains {
  list-style: none;
  margin: 0 auto 1.8rem;
  padding: 0;
  max-width: 720px;
  text-align: center;
}
.g-hero-pains li {
  font-size: 18px;
  font-weight: 400;
  line-height: 1.4;
  color: var(--color-navy);
  padding: 0.45rem 0;
}
.g-hero-pains li:not(:last-child) {
  border-bottom: 1px dashed var(--color-border-warm);
}
.g-hero-creds {
  font-size: 18px;
  font-weight: 500;
  color: var(--color-gold);
  margin: 0 0 1.2rem;
}
.g-hero-bio {
  font-size: 18px;
  font-weight: 400;
  line-height: 1.4;
  color: var(--color-slate);
  max-width: 720px;
  margin: 0 auto 2.4rem;
}
.g-hero-bio strong { color: var(--color-navy); font-weight: 600; }

@media (max-width: 760px) {
  .g-hero { min-height: auto; padding: 7rem 1.2rem 5rem; }
  .g-hero-h1 { font-size: clamp(2rem, 8vw, 3rem); }
  .g-hero-pains li, .g-hero-creds, .g-hero-bio { font-size: 16px; }
}

/* Step CTA pattern (used in hero + step2) */
.g-step-cta {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
  padding: 1.4rem 2.6rem;
  background: var(--color-navy);
  color: var(--color-cream);
  text-decoration: none;
  border-radius: 4px;
  transition: all 0.3s;
  border: 1px solid var(--color-navy);
}
.g-step-cta:hover {
  background: var(--color-navy-deep);
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(28, 42, 58, 0.25);
}
.g-step-cta-primary {
  background: var(--color-gold);
  color: var(--color-navy);
  border-color: var(--color-gold);
}
.g-step-cta-primary:hover {
  background: var(--color-gold-hover);
  border-color: var(--color-gold-hover);
}
.g-step-num {
  font-family: var(--font-heading-sc);
