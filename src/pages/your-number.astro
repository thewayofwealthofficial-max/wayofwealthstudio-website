---
// "Your Cash Flow Session" booking page: the paid 75-minute session (Your Number), £179.99.
// Shape copied from competitors' paid-session pages (research/2026-10-05-competitor-ads/BOOKING_PAGES.md):
// three stages (Charelle Griffith), who it's for + prep form after booking (Jodi McLaren).
// Words: the Calendly description Joel approved 2026-10-05, approved lines from /coaching,
// and verbatim client clips from config/resultsClips. Styles copied from /coaching.
import Layout from '../layouts/Layout.astro';
import { LINKS } from '../config/links';
import { RESULT_CLIPS } from '../config/resultsClips';

const title = "Your Cash Flow Session | Find Out Your Number | Way of Wealth";
const description = "75 minutes, live on screen. I build your cash flow model with you, so you leave knowing how much you actually need to earn, and what that means for your prices and your week. £179.99.";

const CALENDLY_URL = 'https://calendly.com/thewayofwealth-official/your-cash-flow-session';

const STAGES = [
  { n: '1', t: "Your fact find", d: "Once you've booked, I'll send you a short form about your work, your money in and out, and your goal. Rough numbers are fine." },
  { n: '2', t: "Your session", d: "75 minutes, live on screen. I build your cash flow model with you. We put your real numbers in, model different options, and see what each one actually looks like. Doing this, everything kind of falls into place." },
  { n: '3', t: "Your report", d: "Within 48 hours you get your 9-page report to keep." },
];

const COVER = [
  "Your goal",
  "Where your money is today",
  "Your number: what you need to earn each month and year",
  "What that means for your prices, your clients and your days",
  "Two futures, side by side, five years out",
  "Your first three steps, in your words",
];

// Verbatim clips (captions word for word from the audio). These are 12-week coaching clients,
// and the page says so: none of them has had this session yet.
const CLIP_SLUGS = ['alon-2', 'lynt-3', 'jen-4'];
const CLIPS = CLIP_SLUGS.map((s) => RESULT_CLIPS.find((c) => c.slug === s)).filter(Boolean);

const FAQS = [
  { q: "Is this financial advice?", a: "No. I'm a planner, not an adviser. I'm qualified but not FCA authorised. This session does not recommend any product, pension, investment, insurance or debt arrangement. Every figure is an illustration, not a forecast." },
  { q: "I already have an accountant.", a: "Good. An accountant looks backwards to keep you legal. They don't tell you how much of today's invoice you can actually move to your own account. That's the gap we work on." },
  { q: "I'm not in the UK. Can I still book?", a: "Yes. Bring the tax figures your accountant uses for you and we work with those. I don't give tax advice. The price is £179.99, and your bank converts it to your currency." },
  { q: "What do I need to bring?", a: "Just the fact find, filled in before the call. Rough numbers are fine." },
  { q: "What if I need to move my session?", a: "Reschedule free up to 24 hours before your session. No refunds after that. The one exception is my promise: if you don't leave knowing your number, I'll refund you." },
];
---
<Layout title={title} description={description} canonical={`${LINKS.siteUrl}/your-number`}>

<!-- 1 · HERO -->
<section class="sp-hero" id="top">
  <div class="sp-hero-inner sp-hero-single">
    <div class="sp-hero-copy reveal">
      <p class="sp-eyebrow">Your Cash Flow Session · 75 minutes, live</p>
      <h1>Find out your number. <em>Then see what it means for your prices and your week.</em></h1>
      <p class="sp-lead">How much you actually need to earn, worked out live with you. For self-employed people and small service businesses, wherever you are: coaches, therapists, wellness practitioners, consultants, freelancers, creatives and trades.</p>
      <div class="sp-cta-row">
        <a href="#book" class="sp-btn sp-btn-gold">Book your session · £179.99</a>
        <a href="#how" class="sp-link">See how it works ↓</a>
      </div>
      <p class="sp-creds"><b>Joel Ezekiel</b> · MSc Behavioural Economics | Qualified Financial Planner</p>
    </div>
  </div>
</section>

<!-- 2 · HOW IT WORKS (three stages) -->
<section class="sp-section sp-cream" id="how">
  <svg class="sp-wave" style="--wave-fill: var(--color-navy-deep);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,40 C1200,90 960,10 720,50 C480,90 240,10 0,55 Z"/></svg>
  <div class="sp-wide">
    <h2 class="sp-h2 sp-center reveal">How it <em>works.</em></h2>
    <ul class="sp-include-grid">
      {STAGES.map((s) => (
        <li class="sp-include reveal"><span class="yn-step">{s.n}</span><h4>{s.t}</h4><p>{s.d}</p></li>
      ))}
    </ul>
  </div>
</section>

<!-- 3 · WHAT WE COVER -->
<section class="sp-section sp-white">
  <div class="sp-narrow reveal">
    <h2 class="sp-h2">What we <em>cover.</em></h2>
    <ul class="sp-tick">
      {COVER.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<!-- 4 · PRICE + PROMISE -->
<section class="sp-section sp-navy" id="price">
  <svg class="sp-wave" style="--wave-fill: var(--color-bg-white);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,50 C1200,0 960,90 720,40 C480,0 240,80 0,30 Z"/></svg>
  <div class="sp-narrow sp-center reveal">
    <p class="sp-on-dark">In the UK, financial planners charge £500 to £1,500 to build a cash flow model.</p>
    <div class="yn-price">£179.99</div>
    <p class="sp-on-dark">This session. 75 minutes, live, plus your 9-page report.</p>
    <p class="sp-on-dark yn-places">5 places a week.</p>
    <a href="#book" class="sp-btn sp-btn-gold">Book your session</a>
  </div>
</section>

<!-- 5 · PROMISE -->
<section class="sp-section sp-white">
  <svg class="sp-wave" style="--wave-fill: var(--color-navy-deep);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,40 C1200,90 960,10 720,50 C480,90 240,10 0,55 Z"/></svg>
  <div class="sp-narrow sp-center reveal">
    <div class="sp-seal" aria-hidden="true">✓</div>
    <h2 class="sp-h2">My <em>promise</em></h2>
    <p class="sp-strong">If you don't leave knowing your number, I'll refund you.</p>
  </div>
</section>

<!-- 6 · CLIENT CLIPS -->
<section class="sp-section sp-navy" id="results">
  <svg class="sp-wave" style="--wave-fill: var(--color-bg-white);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,50 C1200,0 960,90 720,40 C480,0 240,80 0,30 Z"/></svg>
  <div class="sp-wide">
    <h2 class="sp-h2 sp-on-dark sp-center reveal">What it's like when we<br /><em>look at the numbers together.</em></h2>
    <p class="sp-on-dark sp-center sp-sub reveal">From my 12-week coaching clients, on our calls.</p>
    <div class="sp-video-grid">
      {CLIPS.map((v) => (
        <figure class="sp-vcard reveal">
          <video controls playsinline preload="none" poster={`/testimonials/results/${v!.slug}.jpg`} src={`/testimonials/results/${v!.slug}.mp4`}></video>
          <figcaption><p>"{v!.cap}"</p><small>{v!.who}</small></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- 7 · FOUNDER -->
<section class="sp-section sp-white">
  <svg class="sp-wave" style="--wave-fill: var(--color-navy-deep);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,40 C1200,90 960,10 720,50 C480,90 240,10 0,55 Z"/></svg>
  <div class="sp-wide sp-founder reveal">
    <figure class="sp-portrait">
      <img src="/images/joel-headshot-web.jpg" alt="Joel Ezekiel" loading="lazy" />
    </figure>
    <div>
      <h2 class="sp-h2">Hi, I'm <em>Joel.</em></h2>
      <p>I turned £3,000 into £150,000 trading. I thought I was a genius. Then I lost all of it.</p>
      <p>I didn't even have a degree back then. That's what sent me off to go and study this properly.</p>
      <p>So now I've got an MSc in Behavioural Economics and I'm a Qualified Financial Planner. This is what I love about financial planning: doing cash flow modelling.</p>
    </div>
  </div>
</section>

<!-- 8 · NOT FOR YOU -->
<section class="sp-section sp-cream">
  <div class="sp-narrow reveal">
    <h2 class="sp-h2">This isn't for you <em>if…</em></h2>
    <ul class="sp-tick">
      <li>You want someone to tell you what to invest in. I'm a planner, not an adviser. I don't tell you what to buy.</li>
      <li>You'd rather not look at your real numbers.</li>
    </ul>
  </div>
</section>

<!-- 9 · FAQ -->
<section class="sp-section sp-white" id="faq">
  <div class="sp-narrow">
    <h2 class="sp-h2 sp-center reveal">Commonly asked <em>questions</em></h2>
    <div class="sp-faq reveal">
      {FAQS.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </div>
</section>

<!-- 10 · BOOK -->
<section class="g-apply sp-apply" id="book">
  <svg class="sp-wave" style="--wave-fill: var(--color-bg-white);" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,50 C1200,0 960,90 720,40 C480,0 240,80 0,30 Z"/></svg>
  <div class="g-apply-inner yn-book">
    <p class="sp-eyebrow reveal">Book your session</p>
    <h2 class="g-apply-h2 reveal">Pick a time.<br /><em>Then we'll find your number.</em></h2>
    <p class="g-apply-sub reveal">£179.99, paid when you book. 5 places a week.</p>
    <div class="calendly-inline-widget" data-url={CALENDLY_URL} style="min-width:320px;height:900px;"></div>
    <p class="sp-fine">Joel is qualified but not FCA authorised. This session does not recommend any product, pension, investment, insurance or debt arrangement. Every figure is an illustration, not a forecast. The client clips are real, from 12-week coaching clients. Results vary.</p>
  </div>
</section>

</Layout>

<script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&display=swap');

/* Copied from /coaching (sp-* look), only the parts this page uses. */
.sp-hero, .sp-section, .sp-apply { font-family: 'Inter Tight', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
.sp-h2, .sp-hero h1, .g-apply-h2, .yn-price {
  font-family: 'Fraunces', 'Source Serif 4', Georgia, serif;
  font-variation-settings: "opsz" 144, "SOFT" 50, "WONK" 0;
}
.sp-h2 em, .sp-hero h1 em, .g-apply-h2 em {
  font-style: italic; font-weight: 500; color: var(--color-gold);
  font-variation-settings: "opsz" 144, "SOFT" 0, "WONK" 0;
}
.sp-section { position: relative; padding: 7.5rem 1.5rem 6rem; }
.sp-cream { background: var(--color-cream); color: var(--color-charcoal); }
.sp-white { background: var(--color-bg-white); color: var(--color-charcoal); }
.sp-navy  { background: var(--color-navy-deep); color: var(--color-cream); }
.sp-wide { max-width: 1140px; margin: 0 auto; position: relative; }
.sp-narrow { max-width: 720px; margin: 0 auto; position: relative; }
.sp-center { text-align: center; }
.sp-section .sp-sub { font-size: 1.1rem; margin: -0.5rem auto 2.5rem; max-width: 620px; opacity: 0.85; text-align: center; }
.sp-h2 { font-size: clamp(2rem, 4vw, 3.1rem); font-weight: 700; line-height: 1.08; letter-spacing: -0.015em; margin: 0 0 1.6rem; color: var(--color-navy); }
.sp-on-dark, .sp-navy .sp-h2 { color: var(--color-cream); }
.sp-section p { font-size: 1.1rem; line-height: 1.7; margin: 0 0 1.15rem; }
.sp-strong { font-weight: 700; font-size: 1.2rem !important; }
.sp-eyebrow { display: inline-block; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-gold); margin: 0 0 1.4rem; }
.sp-wave { position: absolute; top: -1px; left: 0; width: 100%; height: clamp(40px, 6vw, 90px); display: block; fill: var(--wave-fill); pointer-events: none; }
.sp-btn { display: inline-block; text-decoration: none; font-weight: 600; font-size: 1rem; letter-spacing: 0.01em; padding: 1.1rem 2.2rem; border-radius: 4px; transition: transform .25s, background .25s, box-shadow .25s; text-align: center; }
.sp-btn-gold { background: var(--color-gold); color: var(--color-navy-deep); }
.sp-btn-gold:hover { background: var(--color-gold-hover); transform: translateY(-2px); box-shadow: 0 12px 28px rgba(0,0,0,0.25); }
.sp-link { color: var(--color-gold-subtle); font-size: 0.98rem; text-decoration: underline; text-underline-offset: 4px; }

.sp-hero { background: var(--color-navy-deep); color: var(--color-cream); padding: 9.5rem 1.5rem 6rem; position: relative; overflow: hidden; }
.sp-hero::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 75% 15%, rgba(196,162,101,0.13), transparent 55%), radial-gradient(circle at 15% 90%, rgba(196,162,101,0.05), transparent 55%); pointer-events: none; }
.sp-hero-inner { max-width: 1180px; margin: 0 auto; position: relative; }
.sp-hero-single { max-width: 820px; }
.sp-hero h1 { font-size: clamp(2.1rem, 3.9vw, 3.4rem); line-height: 1.07; font-weight: 700; letter-spacing: -0.015em; color: var(--color-cream); margin: 0 0 1.5rem; }
.sp-hero h1 em { display: block; margin-top: 0.4rem; }
.sp-lead { font-size: 1.2rem; line-height: 1.6; color: rgba(245,240,232,0.85); margin: 0 0 2rem; }
.sp-cta-row { display: flex; align-items: center; gap: 1.6rem; flex-wrap: wrap; margin-bottom: 1.8rem; }
.sp-creds { font-size: 0.92rem; color: rgba(245,240,232,0.65); margin: 0; }
.sp-creds b { color: var(--color-cream); }

.sp-tick { list-style: none; padding: 0; margin: 1.4rem 0; }
.sp-tick li { position: relative; padding: 0.7rem 0 0.7rem 2.2rem; font-size: 1.08rem; line-height: 1.55; border-bottom: 1px dashed rgba(28,42,58,0.18); }
.sp-tick li::before { content: "✓"; position: absolute; left: 0; top: 0.65rem; color: var(--color-gold); font-weight: 700; }
.sp-tick li:last-child { border-bottom: none; }

.sp-include-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
.sp-include { background: var(--color-bg-white); border: 1px solid var(--color-border-warm); border-radius: 6px; padding: 1.8rem 1.6rem; }
.sp-include h4 { font-family: 'Fraunces', serif; font-size: 1.2rem; color: var(--color-navy); margin: 0 0 0.6rem; }
.sp-include p { font-size: 0.98rem !important; line-height: 1.6 !important; margin: 0 !important; color: var(--color-slate); }
.yn-step { display: block; font-family: 'Fraunces', serif; font-size: 1.9rem; color: var(--color-gold); margin-bottom: 0.4rem; }

.yn-price { font-size: clamp(3.2rem, 7vw, 4.6rem); font-weight: 700; color: var(--color-gold); margin: 0.6rem 0 0.4rem; }
.yn-places { font-weight: 700; }

.sp-seal { width: 92px; height: 92px; border-radius: 50%; border: 3px double var(--color-gold); display: grid; place-items: center; margin: 0 auto 1.4rem; font-family: 'Fraunces', serif; font-size: 2.6rem; color: var(--color-gold); }

.sp-founder { display: grid; grid-template-columns: 340px 1fr; gap: 3.5rem; align-items: start; }
.sp-portrait { margin: 0; }
.sp-portrait img { width: 100%; border-radius: 8px; display: block; }

.sp-video-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 1rem; }
.sp-vcard { margin: 0; background: rgba(245,240,232,0.05); border: 1px solid rgba(196,162,101,0.2); border-radius: 8px; padding: 1rem; }
.sp-vcard video { width: 100%; border-radius: 6px; background: #000; display: block; aspect-ratio: 16/9; object-fit: cover; }
.sp-vcard figcaption { padding: 1rem 0.3rem 0.3rem; }
.sp-vcard figcaption p { font-size: 0.98rem !important; line-height: 1.5 !important; color: var(--color-cream); margin: 0 0 0.5rem !important; }
.sp-vcard figcaption small { color: var(--color-gold-subtle); font-size: 0.82rem; }

.sp-faq { display: grid; gap: 0.8rem; margin-top: 2rem; }
.sp-faq details { background: var(--color-bg-white); border: 1px solid var(--color-border-warm); border-radius: 6px; padding: 0 1.4rem; }
.sp-faq summary { cursor: pointer; font-weight: 600; font-size: 1.05rem; padding: 1.15rem 2rem 1.15rem 0; list-style: none; position: relative; color: var(--color-navy); }
.sp-faq summary::-webkit-details-marker { display: none; }
.sp-faq summary::after { content: "+"; position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 1.5rem; color: var(--color-gold); }
.sp-faq details[open] summary::after { content: "–"; }
.sp-faq details p { padding: 0 0 1.2rem; margin: 0; font-size: 1.02rem; color: var(--color-slate); }

.g-apply { position: relative; padding: 8rem 1.5rem 6rem; background: var(--color-navy-deep); text-align: center; }
.g-apply::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 70% 20%, rgba(196,162,101,0.10), transparent 55%), radial-gradient(circle at 20% 90%, rgba(196,162,101,0.04), transparent 55%); pointer-events: none; }
.g-apply-inner { max-width: 720px; margin: 0 auto; position: relative; }
.yn-book { max-width: 1000px; }
.g-apply-h2 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; line-height: 1.05; color: var(--color-cream); margin: 0 0 1.4rem; letter-spacing: -0.015em; }
.g-apply-sub { font-size: 1.1rem; color: rgba(245,240,232,0.82); max-width: 640px; margin: 0 auto 2.4rem; line-height: 1.55; }
.calendly-inline-widget { border-radius: 8px; overflow: hidden; background: var(--color-cream); }
.sp-fine { margin: 2rem auto 0; max-width: 620px; font-size: 0.82rem; color: rgba(245,240,232,0.55); line-height: 1.6; }

@media (max-width: 1024px) {
  .sp-founder { grid-template-columns: 1fr; gap: 2.2rem; }
  .sp-portrait { max-width: 280px; }
  .sp-include-grid, .sp-video-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 680px) {
  .sp-section { padding: 6rem 1.2rem 4.5rem; }
  .sp-hero { padding: 8rem 1.2rem 4.5rem; }
  .sp-include-grid, .sp-video-grid { grid-template-columns: 1fr; }
  .g-apply { padding: 6rem 1.2rem 4rem; }
}
</style>
