---
import Layout from '../layouts/Layout.astro';
import { LINKS } from '../config/links';

const title = "Way of Wealth — Behavioural money coaching for people who've tried everything else";
const description = "Behavioural economics-led coaching, workbooks, and a free quiz for people who've tried budgets, apps, and spreadsheets — and still feel stuck. MSc Behavioural Economics | Qualified Financial Planner.";
const canonical = LINKS.siteUrl;
---
<Layout title={title} description={description} canonical={canonical}>

<!-- HERO -->
<section class="hero">
  <div class="hero-credential">MSc Behavioural Economics &nbsp;|&nbsp; Qualified Financial Planner</div>
  <h1>You've tried budgets before.<br />Something keeps <em>getting in the way.</em></h1>
  <p class="hero-sub">It's not a willpower problem. It's not a maths problem. It's the way your brain is wired to handle money stress — and it's more common than you think.</p>
  <div class="hero-actions">
    <a href={LINKS.coaching} class="btn-primary">See The Money Story Method</a>
    <a href={LINKS.newsletter} target="_blank" rel="noopener" class="btn-ghost">Join Finance Fridays Newsletter</a>
  </div>
</section>

<!-- ICEBERG — lifted verbatim from coaching.astro -->
<section class="iceberg-section">
  <div class="iceberg-inner reveal">
    <span class="section-tag">The Method, in One Image</span>
    <h2>Budgets live above the waterline.<br /><em>The real work is below.</em></h2>

    <div class="iceberg-layout">
      <!-- ABOVE WATER CARD -->
      <div class="iceberg-card iceberg-above">
        <p class="iceberg-card-label">ABOVE THE WATERLINE · BEHAVIOUR</p>
        <ul class="iceberg-card-list">
          <li>Budgets</li>
          <li>Spreadsheets</li>
          <li>Apps &amp; side hustles</li>
          <li>Finance books &amp; courses</li>
          <li>What you <em>track</em>, what you <em>try</em></li>
        </ul>
      </div>

      <!-- ICEBERG VISUAL -->
      <div class="iceberg-figure" aria-hidden="true">
        <svg viewBox="0 0 300 320" role="img" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="ice-above-v2" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#F5F0E8" />
              <stop offset="100%" stop-color="#E8D5B0" />
            </linearGradient>
            <linearGradient id="ice-below-v2" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1C2A3A" />
              <stop offset="100%" stop-color="#141F2B" />
            </linearGradient>
            <linearGradient id="water-v2" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#C4A265" stop-opacity="0.6" />
              <stop offset="100%" stop-color="#C4A265" stop-opacity="0" />
            </linearGradient>
          </defs>
          <polygon points="120,30 180,30 200,110 100,110" fill="url(#ice-above-v2)" stroke="#C4A265" stroke-width="1.5" />
          <line x1="10" y1="115" x2="290" y2="115" stroke="#C4A265" stroke-width="1.5" stroke-dasharray="4 5" />
          <rect x="10" y="115" width="280" height="6" fill="url(#water-v2)" />
          <polygon points="100,115 200,115 240,280 60,280" fill="url(#ice-below-v2)" stroke="#C4A265" stroke-width="1.2" />
          <path d="M 85 160 L 140 155" stroke="#C4A265" stroke-width="0.8" opacity="0.3" />
          <path d="M 80 210 L 180 205" stroke="#C4A265" stroke-width="0.8" opacity="0.25" />
          <path d="M 75 250 L 220 245" stroke="#C4A265" stroke-width="0.8" opacity="0.2" />
        </svg>
      </div>

      <!-- BELOW WATER CARD -->
      <div class="iceberg-card iceberg-below">
        <p class="iceberg-card-label">BELOW THE WATERLINE · THE STORY</p>
        <ul class="iceberg-card-list iceberg-card-list-below">
          <li>Inherited beliefs about money</li>
          <li>Fear of looking at the number</li>
          <li>Shame loops that override plans</li>
          <li>Identity tangled up in earning</li>
          <li>What you learned <em>before</em> you could name it</li>
        </ul>
      </div>
    </div>

    <p class="iceberg-caption">Most financial advice works above the line. The Money Story Method starts below it.</p>
  </div>
</section>

<!-- WHO THIS IS FOR -->
<section class="whofor">
  <div class="whofor-inner">
    <div class="reveal">
      <span class="section-tag">Who This Is For</span>
      <h2>You might recognise<br />yourself <em>here.</em></h2>
      <p class="whofor-intro">If one or more of these land, you're probably in the right place. None of this makes you broken — it makes you human, and it's more common than the finance world likes to admit.</p>
    </div>
    <ul class="checklist reveal">
      <li>You've downloaded budget templates you never opened</li>
      <li>You check your bank balance less often than you'd like to admit</li>
      <li>"What should I actually charge?" is a question you've never really answered — you just picked a number and hoped nobody would ask why</li>
      <li>You've felt a flicker of guilt charging good money for work that's also meaningful to you</li>
      <li>Your income swings from a fully-booked month to weeks of almost nothing, and you've never built anything to survive the gap</li>
      <li>You want to feel calm about money, not just "good at it"</li>
    </ul>
  </div>
</section>

<!-- TESTIMONIALS -->
<section class="testis-section">
  <div class="testis-inner">
    <span class="section-tag reveal">Don't Take My Word For It</span>
    <h2 class="reveal">People who were exactly<br />where you are <em>now.</em></h2>

    <div class="testis-feature reveal">
      <video class="testis-feature-vid" controls preload="none" playsinline poster="/testimonials/josh-book-the-call.jpg" src="/testimonials/josh-book-the-call.mp4"></video>
      <blockquote class="testis-feature-quote">
        "Book that first call with Joel. Just do it — one call is all it takes."
        <cite>— Josh, yacht chef · came in stuck in debt, left debt-free and on a five-year plan</cite>
      </blockquote>
    </div>

    <div class="testis-grid">
      <div class="testis-card reveal">
        <video class="testis-vid" controls preload="none" playsinline poster="/testimonials/josh-pedestal.jpg" src="/testimonials/josh-pedestal.mp4"></video>
        <p class="testis-quote">"You've taken money off the pedestal — now it's a tool I'm in control of, not the other way round."</p>
        <p class="testis-name">— Josh, yacht chef</p>
      </div>
      <div class="testis-card reveal">
        <video class="testis-vid" controls preload="none" playsinline poster="/testimonials/alon-opportunity.jpg" src="/testimonials/alon-opportunity.mp4"></video>
        <p class="testis-quote">From avoiding money as "just status" to seeing it as a tool for freedom — now planning his own studio.</p>
        <p class="testis-name">— Alon, personal trainer</p>
      </div>
      <div class="testis-card reveal">
        <video class="testis-vid" controls preload="none" playsinline poster="/testimonials/shambhavi-worth.jpg" src="/testimonials/shambhavi-worth.mp4"></video>
        <p class="testis-quote">Left calmer about money — and clear on her worth, no longer settling for less than she deserves.</p>
        <p class="testis-name">— Shambhavi, finishing her master's</p>
      </div>
      <div class="testis-card reveal">
        <video class="testis-vid" controls preload="none" playsinline poster="/testimonials/lynton-autopilot.jpg" src="/testimonials/lynton-autopilot.mp4"></video>
        <p class="testis-quote">Spotted the autopilot spending quietly draining him — and built a system to stop it.</p>
        <p class="testis-name">— Lynton, personal trainer</p>
      </div>
      <div class="testis-card reveal">
        <video class="testis-vid" controls preload="none" playsinline poster="/testimonials/shira-breakthrough.jpg" src="/testimonials/shira-breakthrough.mp4"></video>
        <p class="testis-quote">A breakthrough moment — seeing what her money could actually build.</p>
        <p class="testis-name">— Shira</p>
      </div>
      <div class="testis-card reveal">
        <video class="testis-vid" controls preload="none" playsinline poster="/testimonials/jessica-leaks.jpg" src="/testimonials/jessica-leaks.mp4"></video>
        <p class="testis-quote">Found exactly where her money was leaking — and started plugging the holes.</p>
        <p class="testis-name">— Jessica</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT'S HERE -->
<section class="whats-here" id="whats-here">
  <div class="whats-here-inner">
    <div class="section-header reveal">
      <span class="section-tag">What's Actually Here</span>
      <h2>Simple, honest places to <em>start.</em></h2>
    </div>

    <!-- FLAGSHIP CARD: full-width row above the 4-card grid -->
    <a href="/coaching" class="flagship reveal">
      <div class="flagship-body">
        <span class="flagship-label">Flagship · 1:1 Programme</span>
        <h3>The Money Story Method</h3>
        <p class="flagship-sub">12-week 1:1 behavioural coaching</p>
        <p class="flagship-desc">The deep version of this work. For anyone who's tried everything and wants to go underneath the budgets and apps — into the story running the pattern.</p>
        <span class="flagship-cta">See the programme →</span>
      </div>
      <div class="flagship-aside" aria-hidden="true">
        <span class="flagship-aside-num">01</span>
        <span class="flagship-aside-label">The full method</span>
      </div>
    </a>
  </div>
</section>

<!-- ABOUT (short) -->
<section class="about" id="about">
  <div class="about-inner reveal">
    <span class="section-tag">About</span>
    <div class="about-layout">
      <figure class="about-portrait">
        <img src="/images/joel-headshot.jpg" alt="Joel — Way of Wealth" loading="lazy" />
        <figcaption>Joel · MSc Behavioural Economics · QFP (UK)</figcaption>
      </figure>
      <div class="about-body">
        <h2>A quick note on <em>why me.</em></h2>
        <p>I studied behavioural economics at MSc level to understand why smart, capable people make money decisions that don't look logical on paper.</p>
        <p>Then I spent years as a qualified financial planner, watching people walk out of meetings with sound plans and change almost nothing about how they lived.</p>
        <p>Way of Wealth is what I built to work the layer underneath — the one every standard plan skips over.</p>
        <a href="/coaching#origin" class="about-link">Read the full story →</a>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section" id="start">
  <div class="cta-inner reveal">
    <h2>Not ready for coaching yet?<br />Start where it's <em>quiet.</em></h2>
    <p>Finance Fridays — honest, research-based notes on money and behaviour, straight to your inbox once a week. No upsells buried in every issue, just the thinking that eventually leads people to book a call.</p>
    <a href={LINKS.newsletter} target="_blank" rel="noopener" class="btn-primary btn-primary-lg">Join Finance Fridays</a>
    <div class="cta-reassure">One email a week. Unsubscribe any time. No webinar, no catch.</div>
  </div>
</section>

</Layout>

<style>
  /* --- HERO --- */
  .hero {
    min-height: 92vh;
    background: var(--color-navy);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 9rem 2rem 5rem;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 4px;
    background: var(--color-gold);
  }
  .hero::after {
    content: '';
    position: absolute;
    top: -30%; left: 50%;
    transform: translateX(-50%);
    width: 900px; height: 900px;
    background: radial-gradient(ellipse, rgba(196, 162, 101, 0.05) 0%, transparent 65%);
    pointer-events: none;
  }
  .hero-credential {
    font-family: var(--font-heading-sc);
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    margin-bottom: 2.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(196, 162, 101, 0.4);
    position: relative;
    z-index: 2;
  }
  .hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    max-width: 920px;
    color: var(--color-cream);
    position: relative;
    z-index: 2;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--color-gold);
    font-weight: 400;
  }
  .hero-sub {
    font-family: var(--font-body);
    font-size: 1.15rem;
    color: rgba(245, 240, 232, 0.82);
    max-width: 580px;
    line-height: 1.75;
    margin-top: 2rem;
    font-weight: 400;
    position: relative;
    z-index: 2;
  }
  .hero-actions {
    margin-top: 2.75rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    position: relative;
    z-index: 2;
  }

  /* --- ICEBERG (lifted from coaching.astro) --- */
  .iceberg-section {
    padding: 6rem 2rem;
    background: var(--color-cream);
  }
  .iceberg-inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }
  .iceberg-section h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-charcoal);
    margin-bottom: 2.5rem;
  }
  .iceberg-section h2 em { font-style: italic; color: var(--color-gold); font-weight: 400; }
  .iceberg-layout {
    display: grid;
    grid-template-columns: 1fr 280px 1fr;
    gap: 2rem;
    align-items: center;
    margin-bottom: 2rem;
  }
  .iceberg-figure {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .iceberg-figure svg {
    width: 100%;
    max-width: 260px;
    height: auto;
  }
  .iceberg-card {
    padding: 1.75rem;
    border-radius: 8px;
    text-align: left;
  }
  .iceberg-above {
    background: var(--color-bg-white);
    border: 1px solid var(--color-border-warm);
  }
  .iceberg-below {
    background: var(--color-navy);
    color: var(--color-cream);
  }
  .iceberg-card-label {
    font-family: var(--font-heading-sc);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--color-gold);
    margin: 0 0 0.85rem;
  }
  .iceberg-above .iceberg-card-label { color: var(--color-slate); }
  .iceberg-card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.85;
  }
  .iceberg-above .iceberg-card-list { color: var(--color-charcoal); }
  .iceberg-below .iceberg-card-list { color: var(--color-cream); }
  .iceberg-card-list li { position: relative; padding-left: 1rem; }
  .iceberg-card-list li::before {
    content: '·';
    color: var(--color-gold);
    position: absolute;
    left: 0;
    font-weight: 700;
  }
  .iceberg-card-list em { font-style: italic; color: var(--color-gold); }
  .iceberg-below .iceberg-card-list em { color: var(--color-gold-subtle); }
  .iceberg-caption {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-slate);
    margin-top: 2rem;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }
  @media (max-width: 900px) {
    .iceberg-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .iceberg-figure { order: 2; }
    .iceberg-above { order: 1; }
    .iceberg-below { order: 3; }
    .iceberg-figure svg { max-width: 200px; }
  }

  /* --- WHO THIS IS FOR --- */
  .whofor { padding: 7rem 2rem; background: var(--color-bg-white); }
  .whofor-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 5rem;
    align-items: start;
  }
  .whofor h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 3.2vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-charcoal);
    margin-bottom: 1.5rem;
  }
  .whofor h2 em { font-style: italic; color: var(--color-gold); font-weight: 400; }
  .whofor p.whofor-intro {
    color: var(--color-slate);
    font-size: 1.02rem;
    line-height: 1.8;
  }
  .checklist { list-style: none; padding: 0; }
  .checklist li {
    padding: 1.1rem 0 1.1rem 2rem;
    border-bottom: 1px solid var(--color-border-warm);
    font-size: 1.02rem;
    color: var(--color-charcoal);
    position: relative;
    line-height: 1.6;
  }
  .checklist li:last-child { border-bottom: none; }
  .checklist li::before {
    content: '—';
    position: absolute;
    left: 0;
    top: 1.1rem;
    color: var(--color-gold);
    font-weight: 500;
  }

  /* --- WHAT'S HERE --- */
  .whats-here { padding: 7rem 2rem; background: var(--color-bg-cool); }
  .whats-here-inner { max-width: 1100px; margin: 0 auto; }
  .whats-here .section-header { text-align: center; margin-bottom: 4rem; }
  .whats-here h2 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 400;
    color: var(--color-charcoal);
    line-height: 1.2;
  }
  .whats-here h2 em { font-style: italic; color: var(--color-gold); font-weight: 400; }

  /* FLAGSHIP CARD — full-width row above the 4-card grid */
  .flagship {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 2.5rem;
    align-items: stretch;
    background: var(--color-navy);
    color: var(--color-cream);
    padding: 2.75rem 3rem;
    border-radius: 8px;
    border: 2px solid var(--color-gold);
    box-shadow: 0 8px 28px rgba(28, 42, 58, 0.12);
    text-decoration: none;
    margin-bottom: 2.25rem;
    transition: transform 0.3s, box-shadow 0.3s;
    position: relative;
    overflow: hidden;
  }
  .flagship::before {
    content: '';
    position: absolute;
    top: -40%; right: -15%;
    width: 360px; height: 360px;
    background: radial-gradient(ellipse, rgba(196, 162, 101, 0.10) 0%, transparent 65%);
    pointer-events: none;
  }
  .flagship:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgba(28, 42, 58, 0.18);
  }
  .flagship-body { position: relative; z-index: 2; }
  .flagship-label {
    font-family: var(--font-heading-sc);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.9rem;
  }
  .flagship h3 {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-cream);
    margin-bottom: 0.35rem;
  }
  .flagship-sub {
    font-family: var(--font-heading-sc);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: var(--color-gold-subtle);
    margin-bottom: 1.1rem;
  }
  .flagship-desc {
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.8;
    color: rgba(245, 240, 232, 0.82);
    max-width: 640px;
    margin-bottom: 1.4rem;
  }
  .flagship-cta {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-gold);
    transition: transform 0.3s, color 0.3s;
  }
  .flagship:hover .flagship-cta {
    color: var(--color-gold-hover);
    transform: translateX(3px);
  }
  .flagship-aside {
    position: relative;
    z-index: 2;
    border-left: 1px solid rgba(196, 162, 101, 0.45);
    padding-left: 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .flagship-aside-num {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 3.2rem;
    color: var(--color-gold);
    line-height: 1;
  }
  .flagship-aside-label {
    font-family: var(--font-heading-sc);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    color: rgba(245, 240, 232, 0.82);
    margin-top: 0.75rem;
  }

  /* --- TESTIMONIALS --- */
  .testis-section { padding: 7rem 2rem; background: var(--color-navy); }
  .testis-inner { max-width: 1100px; margin: 0 auto; text-align: center; }
  .testis-inner .section-tag { color: var(--color-gold); }
  .testis-inner h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-cream);
    margin-bottom: 3.5rem;
  }
  .testis-inner h2 em { font-style: italic; color: var(--color-gold); font-weight: 400; }

  .testis-feature {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 2.5rem;
    align-items: center;
    text-align: left;
    background: rgba(245, 240, 232, 0.04);
    border: 1px solid rgba(196, 162, 101, 0.25);
    border-radius: 10px;
    padding: 2rem;
    margin-bottom: 2.5rem;
  }
  .testis-feature-vid {
    width: 100%;
    border-radius: 6px;
    display: block;
    background: #000;
  }
  .testis-feature-quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.4rem;
    line-height: 1.5;
    color: var(--color-cream);
    margin: 0;
  }
  .testis-feature-quote cite {
    display: block;
    margin-top: 1.25rem;
    font-family: var(--font-ui);
    font-style: normal;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--color-gold-subtle);
  }

  .testis-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    text-align: left;
  }
  .testis-card {
    background: rgba(245, 240, 232, 0.04);
    border: 1px solid rgba(196, 162, 101, 0.18);
    border-radius: 8px;
    padding: 1.25rem;
    transition: transform 0.3s, border-color 0.3s;
  }
  .testis-card:hover {
    transform: translateY(-2px);
    border-color: rgba(196, 162, 101, 0.4);
  }
  .testis-vid {
    width: 100%;
    border-radius: 6px;
    display: block;
    background: #000;
    margin-bottom: 1rem;
  }
  .testis-quote {
