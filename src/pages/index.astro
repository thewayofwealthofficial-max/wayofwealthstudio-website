---
import Layout from '../layouts/Layout.astro';
import { LINKS } from '../config/links';
import { getCollection } from 'astro:content';

const title = "Way of Wealth | Behavioural money coaching for people who've tried everything else";
const description = "Behavioural money coaching for self-employed people who earn well and still feel like they keep none of it. A 12-week 1:1 programme and a free weekly newsletter. MSc Behavioural Economics | Qualified Financial Planner.";
const canonical = LINKS.siteUrl;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const VSL_SRC = 'https://discover.thewayofwealth.shop/vsl/vsl.mp4';
const VSL_POSTER = 'https://discover.thewayofwealth.shop/vsl/vsl-poster.jpg';

const FOR_YOU = [
  "You've downloaded budget templates you never opened.",
  "You check your bank balance less often than you'd like to admit.",
  "\"What should I actually charge?\" is a question you've never really answered. You picked a number and hoped nobody would ask why.",
  "You feel a flicker of guilt charging good money for work that also means something to you.",
  "Your income swings from a fully booked month to weeks of almost nothing, and you've never built anything to survive the gap.",
  "You want to feel calm about money, not just \"good at it\".",
];

const CREDS = ["MSc Behavioural Economics", "Qualified Financial Planner (UK)", "Klontz Money Scripts", "Kahneman · Thaler · Duhigg"];

const QUOTES = [
  "It's almost like looking in a mirror.",
  "I feel seen and called out at the same time.",
  "Permission. That one word defines my whole life.",
];

const VIDEOS = [
  { slug: "josh-pedestal", cap: "You've taken money off the pedestal. Now it's a tool I'm in control of, not the other way round.", who: "Josh, yacht chef" },
  { slug: "alon-opportunity", cap: "From avoiding money as \"just status\" to seeing it as a tool for freedom.", who: "Alon, personal trainer" },
  { slug: "shambhavi-worth", cap: "Calmer about money, and clear on her worth.", who: "Shambhavi, finishing her master's" },
  { slug: "lynton-autopilot", cap: "Spotted the autopilot spending quietly draining him, and built a system to stop it.", who: "Lynton, personal trainer" },
  { slug: "shira-breakthrough", cap: "A breakthrough moment: seeing what her money could actually build.", who: "Shira" },
  { slug: "jessica-leaks", cap: "Found exactly where her money was leaking, and started closing the gaps.", who: "Jessica" },
];

const dateFmt = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Layout title={title} description={description} canonical={canonical}>

<!-- 1 · HERO: photo + overlay card -->
<section class="hm-hero">
  <div class="hm-hero-photo" aria-hidden="true"></div>
  <div class="hm-hero-inner">
    <div class="hm-card reveal">
      <p class="hm-script">Joel Ezekiel</p>
      <h1>Behavioural money coach for people who earn well and still don't feel like they keep it.</h1>
      <p class="hm-card-sub">Stop the tax panic and the 2am balance checks. Build a money system that runs even when you're tired.</p>
      <div class="hm-actions">
        <a href={LINKS.coaching} class="btn-primary">See The Money Story Method</a>
        <a href={LINKS.newsletter} target="_blank" rel="noopener" class="hm-ghost">Join Finance Fridays</a>
      </div>
      <p class="hm-creds-line">MSc Behavioural Economics &nbsp;|&nbsp; Qualified Financial Planner</p>
    </div>
  </div>
</section>

<!-- 2 · HI, I'M JOEL + who it's for -->
<section class="hm-intro" id="about">
  <div class="hm-intro-inner">
    <div class="reveal">
      <h2 class="hm-script-h">Hi, I'm Joel.</h2>
      <p>I'm a behavioural money coach and a Qualified Financial Planner. I work with self-employed people, coaches and practitioners who earn well and still feel broke.</p>
      <p>I'll show you how to stop the tax panic, the 2am balance checks and the feast-and-famine months. And we build a system that looks after your money, so you don't need willpower.</p>
      <p class="hm-accent">My 12-week programme, The Money Story Method, is how we do it, one to one.</p>
      <p class="hm-lead-in">This is for you if:</p>
      <ul class="hm-tick">
        {FOR_YOU.map((t) => <li>{t}</li>)}
      </ul>
      <a href="/coaching#apply" class="btn-primary">Book your free call</a>
    </div>
    <div class="hm-video reveal">
      <video controls playsinline preload="none" poster={VSL_POSTER} src={VSL_SRC}></video>
      <p class="hm-video-cap">Watch: how the Money Story Method works</p>
    </div>
  </div>
</section>

<!-- 3 · CREDENTIALS BAND -->
<section class="hm-band">
  <p class="hm-band-label">Trained in · grounded in</p>
  <ul class="hm-band-row">
    {CREDS.map((c) => <li>{c}</li>)}
  </ul>
</section>

<!-- 4 · HOW CAN I HELP -->
<section class="hm-help">
  <h2 class="hm-h2 reveal">How can I help you?</h2>
  <div class="hm-help-grid">
    <article class="hm-help-card reveal">
      <div class="hm-help-top"><span>1:1 · 12 weeks</span></div>
      <h3>The Money Story Method</h3>
      <p><b>WORK WITH ME</b> to build your money system, one to one, and change the habits underneath it. Free 20-minute call to start.</p>
      <a href={LINKS.coaching} class="hm-card-btn">See the programme</a>
    </article>
    <article class="hm-help-card reveal">
      <div class="hm-help-top"><span>Free · weekly</span></div>
      <h3>Finance Fridays</h3>
      <p><b>READ</b> honest, research-based notes on money and behaviour. One email a week, one-click unsubscribe any time.</p>
      <a href={LINKS.newsletter} target="_blank" rel="noopener" class="hm-card-btn">Join for free</a>
    </article>
  </div>
</section>

<!-- 5 · METHOD IN ONE IMAGE -->
<section class="iceberg-section">
  <div class="iceberg-inner reveal">
    <span class="section-tag">The Method, in One Image</span>
    <h2>Budgets live above the waterline.<br /><em>The real work is below.</em></h2>
    <div class="iceberg-layout">
      <div class="iceberg-card iceberg-above">
        <p class="iceberg-card-label">ABOVE THE WATERLINE · BEHAVIOUR</p>
        <ul class="iceberg-card-list">
          <li>Budgets</li>
          <li>Spreadsheets</li>
          <li>Apps &amp; side hustles</li>
          <li>Finance books &amp; courses</li>
          <li>What you <em>track</em>, what you <em>try</em></li>
        </ul>
      </div>
      <div class="iceberg-figure" aria-hidden="true">
        <svg viewBox="0 0 300 320" role="img" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="ice-above-v2" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#F5F0E8" /><stop offset="100%" stop-color="#E8D5B0" /></linearGradient>
            <linearGradient id="ice-below-v2" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1C2A3A" /><stop offset="100%" stop-color="#141F2B" /></linearGradient>
            <linearGradient id="water-v2" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#C4A265" stop-opacity="0.6" /><stop offset="100%" stop-color="#C4A265" stop-opacity="0" /></linearGradient>
          </defs>
          <polygon points="120,30 180,30 200,110 100,110" fill="url(#ice-above-v2)" stroke="#C4A265" stroke-width="1.5" />
          <line x1="10" y1="115" x2="290" y2="115" stroke="#C4A265" stroke-width="1.5" stroke-dasharray="4 5" />
          <rect x="10" y="115" width="280" height="6" fill="url(#water-v2)" />
          <polygon points="100,115 200,115 240,280 60,280" fill="url(#ice-below-v2)" stroke="#C4A265" stroke-width="1.2" />
          <path d="M 85 160 L 140 155" stroke="#C4A265" stroke-width="0.8" opacity="0.3" />
          <path d="M 80 210 L 180 205" stroke="#C4A265" stroke-width="0.8" opacity="0.25" />
          <path d="M 75 250 L 220 245" stroke="#C4A265" stroke-width="0.8" opacity="0.2" />
        </svg>
      </div>
      <div class="iceberg-card iceberg-below">
        <p class="iceberg-card-label">BELOW THE WATERLINE · THE STORY</p>
        <ul class="iceberg-card-list iceberg-card-list-below">
          <li>Inherited beliefs about money</li>
          <li>Fear of looking at the number</li>
          <li>Shame loops that override plans</li>
          <li>Identity tangled up in earning</li>
          <li>What you learned <em>before</em> you could name it</li>
        </ul>
      </div>
    </div>
    <p class="iceberg-caption">Most financial advice works above the line. The Money Story Method starts below it.</p>
  </div>
</section>

<!-- 6 · CLIENT WINS -->
<section class="hm-wins">
  <svg class="hm-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0 L1440,0 L1440,50 C1200,0 960,90 720,40 C480,0 240,80 0,30 Z"/></svg>
  <div class="hm-wins-inner">
    <h2 class="hm-h2 hm-h2-light reveal">Client wins</h2>
    <p class="hm-wins-sub reveal">In their own words. Real people, real recordings.</p>
    <ul class="hm-qrow">
      {QUOTES.map((q) => (
        <li class="hm-qcard reveal"><span aria-hidden="true">“</span><p>{q}</p><small>Money Story Method client</small></li>
      ))}
    </ul>
    <div class="hm-vgrid">
      {VIDEOS.map((v) => (
        <figure class="hm-vcard reveal">
          <video controls playsinline preload="none" poster={`/testimonials/${v.slug}.jpg`} src={`/testimonials/${v.slug}.mp4`}></video>
          <figcaption><p>{v.cap}</p><small>{v.who}</small></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- 7 · READ ALL ABOUT IT -->
<section class="hm-read">
  <h2 class="hm-h2 reveal">Read all about it</h2>
  <div class="hm-read-grid">
    {posts.map((p) => (
      <a href={`/blog/${p.id}/`} class="hm-read-card reveal">
        <span class="hm-read-cat">{p.data.category}</span>
        <h3>{p.data.title}</h3>
        <p>{p.data.description}</p>
        <small>{dateFmt.format(p.data.pubDate)}</small>
      </a>
    ))}
  </div>
  <p class="hm-read-more"><a href="/blog">Read the blog →</a></p>
</section>

<!-- 8 · NEWSLETTER BAND -->
<section class="cta-section" id="start">
  <div class="cta-inner reveal">
    <h2>Not ready for coaching yet?<br />Start where it's <em>quiet.</em></h2>
    <p>Finance Fridays is one email a week on money and how we behave with it. Honest, and based on the research. There's no upsell in every issue.</p>
    <a href={LINKS.newsletter} target="_blank" rel="noopener" class="btn-primary btn-primary-lg">Join Finance Fridays</a>
    <div class="cta-reassure">One email a week. Unsubscribe any time. No webinar, no catch.</div>
  </div>
</section>

</Layout>

<style>
  /* ---------- HERO (photo + overlay card) ---------- */
  .hm-hero { position: relative; min-height: 92vh; background: var(--color-navy-deep); display: flex; align-items: center; overflow: hidden; padding: 9rem 2rem 5rem; }
  .hm-hero::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--color-gold); z-index: 3; }
  .hm-hero-photo { position: absolute; top: 0; right: 0; bottom: 0; width: 58%; background: url('/images/joel-headshot-web.jpg') center 18% / cover no-repeat; -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 38%); mask-image: linear-gradient(to right, transparent 0%, #000 38%); }
  .hm-hero-inner { position: relative; z-index: 2; max-width: 1180px; width: 100%; margin: 0 auto; }
  .hm-card { max-width: 560px; background: rgba(20,31,43,0.94); border: 1px solid rgba(196,162,101,0.4); border-radius: 8px; padding: 2.6rem 2.4rem; box-shadow: 0 30px 80px rgba(0,0,0,0.45); }
  .hm-script { font-family: var(--font-heading); font-style: italic; font-size: 2.1rem; color: var(--color-gold); margin: 0 0 1rem; line-height: 1.1; }
  .hm-card h1 { font-family: var(--font-heading); font-weight: 400; font-size: clamp(1.7rem, 2.8vw, 2.35rem); line-height: 1.25; color: var(--color-cream); margin: 0 0 1.1rem; }
  .hm-card-sub { font-size: 1.08rem; line-height: 1.65; color: rgba(245,240,232,0.85); margin: 0 0 1.8rem; }
  .hm-actions { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin-bottom: 1.4rem; }
  .hm-ghost { color: var(--color-cream); font-family: var(--font-ui); font-size: 0.95rem; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(196,162,101,0.7); padding: 0.4rem 0.2rem; }
  .hm-ghost:hover { color: var(--color-gold); }
  .hm-creds-line { font-family: var(--font-heading-sc); font-size: 0.74rem; letter-spacing: 0.14em; color: var(--color-gold-subtle); margin: 0; }

  /* ---------- INTRO ---------- */
  .hm-intro { padding: 7rem 2rem; background: var(--color-bg-white); }
  .hm-intro-inner { max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr 1fr; gap: 4rem; align-items: start; }
  .hm-script-h { font-family: var(--font-heading); font-style: italic; font-weight: 400; font-size: clamp(2.4rem, 4.5vw, 3.6rem); color: var(--color-gold); margin: 0 0 1.4rem; line-height: 1.05; }
  .hm-intro p { font-size: 1.08rem; line-height: 1.75; color: var(--color-charcoal); margin: 0 0 1.1rem; }
  .hm-accent { color: var(--color-gold) !important; font-weight: 500; }
  .hm-lead-in { font-weight: 700; margin-top: 1.6rem !important; color: var(--color-navy) !important; }
  .hm-tick { list-style: none; margin: 0 0 2rem; padding: 0; }
  .hm-tick li { position: relative; padding: 0.7rem 0 0.7rem 2.1rem; border-bottom: 1px solid var(--color-border-warm); font-size: 1.02rem; line-height: 1.55; color: var(--color-charcoal); }
  .hm-tick li:last-child { border-bottom: none; }
  .hm-tick li::before { content: '✓'; position: absolute; left: 0; top: 0.65rem; color: var(--color-gold); font-weight: 700; }
  .hm-video { position: sticky; top: 7rem; }
  .hm-video video { width: 100%; aspect-ratio: 16/9; border-radius: 8px; background: #000; border: 1px solid rgba(196,162,101,0.4); box-shadow: 0 20px 50px rgba(28,42,58,0.25); display: block; }
  .hm-video-cap { text-align: center; font-family: var(--font-ui); font-size: 0.85rem !important; color: var(--color-slate) !important; margin: 0.9rem 0 0 !important; }

  /* ---------- CREDENTIALS BAND ---------- */
  .hm-band { background: var(--color-gold-subtle); text-align: center; padding: 2.6rem 1.5rem; }
  .hm-band-label { font-family: var(--font-heading-sc); font-size: 0.74rem; letter-spacing: 0.22em; color: var(--color-navy); margin: 0 0 1rem; }
  .hm-band-row { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem 2.4rem; }
  .hm-band-row li { font-family: var(--font-heading); font-style: italic; font-size: 1.05rem; color: var(--color-navy); }

  /* ---------- HOW CAN I HELP ---------- */
  .hm-help { padding: 7rem 2rem; background: var(--color-bg-white); text-align: center; }
  .hm-h2 { font-family: var(--font-heading); font-weight: 400; font-size: clamp(2rem, 3.8vw, 2.9rem); color: var(--color-navy); margin: 0 0 3rem; }
  .hm-h2-light { color: var(--color-cream); margin-bottom: 0.8rem; }
  .hm-help-grid { max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .hm-help-card { background: #fff; border: 1px solid var(--color-border-warm); border-radius: 6px; box-shadow: 0 10px 35px rgba(28,42,58,0.08); overflow: hidden; display: flex; flex-direction: column; text-align: center; }
  .hm-help-top { background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-deep) 100%); padding: 3.2rem 1rem; }
  .hm-help-top span { font-family: var(--font-heading-sc); letter-spacing: 0.2em; font-size: 0.85rem; color: var(--color-gold); }
  .hm-help-card h3 { font-family: var(--font-heading); font-weight: 400; font-size: 1.7rem; color: var(--color-navy); margin: 1.8rem 1.2rem 0.8rem; }
  .hm-help-card p { font-size: 1rem; line-height: 1.65; color: var(--color-charcoal); margin: 0 1.6rem 1.6rem; flex: 1; }
  .hm-card-btn { align-self: center; margin-bottom: 2.2rem; background: var(--color-gold); color: var(--color-navy-deep); font-family: var(--font-ui); font-weight: 600; font-size: 0.9rem; text-decoration: none; padding: 0.85rem 1.8rem; border-radius: 3px; transition: background .25s, transform .25s; }
  .hm-card-btn:hover { background: var(--color-gold-hover); transform: translateY(-2px); }

  /* ---------- ICEBERG ---------- */
  .iceberg-section { padding: 6rem 2rem; background: var(--color-cream); }
  .iceberg-inner { max-width: 1100px; margin: 0 auto; text-align: center; }
  .iceberg-section h2 { font-family: var(--font-heading); font-size: clamp(1.9rem, 3.5vw, 2.6rem); font-weight: 400; line-height: 1.2; color: var(--color-charcoal); margin-bottom: 2.5rem; }
  .iceberg-section h2 em { font-style: italic; color: var(--color-gold); font-weight: 400; }
  .iceberg-layout { display: grid; grid-template-columns: 1fr 280px 1fr; gap: 2rem; align-items: center; margin-bottom: 2rem; }
  .iceberg-figure { display: flex; justify-content: center; align-items: center; }
  .iceberg-figure svg { width: 100%; max-width: 260px; height: auto; }
  .iceberg-card { padding: 1.75rem; border-radius: 8px; text-align: left; }
  .iceberg-above { background: var(--color-bg-white); border: 1px solid var(--color-border-warm); }
  .iceberg-below { background: var(--color-navy); color: var(--color-cream); }
  .iceberg-card-label { font-family: var(--font-heading-sc); font-size: 0.72rem; letter-spacing: 0.14em; color: var(--color-gold); margin: 0 0 0.85rem; }
  .iceberg-above .iceberg-card-label { color: var(--color-slate); }
  .iceberg-card-list { list-style: none; padding: 0; margin: 0; font-family: var(--font-body); font-size: 0.98rem; line-height: 1.85; }
  .iceberg-above .iceberg-card-list { color: var(--color-charcoal); }
  .iceberg-below .iceberg-card-list { color: var(--color-cream); }
  .iceberg-card-list li { position: relative; padding-left: 1rem; }
  .iceberg-card-list li::before { content: '·'; color: var(--color-gold); position: absolute; left: 0; font-weight: 700; }
  .iceberg-card-list em { font-style: italic; color: var(--color-gold); }
  .iceberg-below .iceberg-card-list em { color: var(--color-gold-subtle); }
  .iceberg-caption { font-family: var(--font-body); font-style: italic; font-size: 1.05rem; color: var(--color-slate); margin: 2rem auto 0; max-width: 640px; }

  /* ---------- CLIENT WINS ---------- */
  .hm-wins { position: relative; background: var(--color-navy-deep); padding: 8rem 2rem 6rem; text-align: center; }
  .hm-wave { position: absolute; top: -1px; left: 0; width: 100%; height: clamp(40px, 6vw, 90px); fill: var(--color-cream); display: block; pointer-events: none; }
  .hm-wins-inner { max-width: 1140px; margin: 0 auto; }
  .hm-wins-sub { color: rgba(245,240,232,0.75); font-size: 1.05rem; margin: 0 0 3rem; }
  .hm-qrow { list-style: none; margin: 0 0 2rem; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  .hm-qcard { position: relative; background: #fff; border-radius: 4px; padding: 2rem 1.6rem 1.6rem; text-align: center; }
  .hm-qcard span { display: block; font-family: var(--font-heading); font-size: 3rem; line-height: 0.6; color: var(--color-gold); margin-bottom: 0.9rem; }
  .hm-qcard p { font-family: var(--font-heading); font-style: italic; font-size: 1.15rem; line-height: 1.5; color: var(--color-navy); margin: 0 0 1rem; }
  .hm-qcard small { color: var(--color-slate); font-size: 0.82rem; }
  .hm-vgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; text-align: left; }
  .hm-vcard { margin: 0; background: rgba(245,240,232,0.05); border: 1px solid rgba(196,162,101,0.2); border-radius: 8px; padding: 1rem; }
  .hm-vcard video { width: 100%; border-radius: 6px; background: #000; display: block; aspect-ratio: 16/9; object-fit: cover; }
  .hm-vcard figcaption { padding: 1rem 0.3rem 0.3rem; }
  .hm-vcard figcaption p { font-size: 0.95rem; line-height: 1.5; color: var(--color-cream); margin: 0 0 0.5rem; }
  .hm-vcard figcaption small { color: var(--color-gold-subtle); font-size: 0.82rem; }

  /* ---------- READ ALL ABOUT IT ---------- */
  .hm-read { padding: 7rem 2rem 5rem; background: var(--color-bg-white); text-align: center; }
  .hm-read-grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; text-align: left; }
  .hm-read-card { display: flex; flex-direction: column; background: var(--color-cream); border-left: 3px solid var(--color-gold); border-radius: 4px; padding: 1.8rem 1.6rem; text-decoration: none; color: inherit; transition: transform .25s, box-shadow .25s; }
  .hm-read-card:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(28,42,58,0.1); }
  .hm-read-cat { font-family: var(--font-heading-sc); font-size: 0.7rem; letter-spacing: 0.16em; color: var(--color-slate); margin-bottom: 0.7rem; text-transform: uppercase; }
  .hm-read-card h3 { font-family: var(--font-heading); font-weight: 400; font-size: 1.3rem; line-height: 1.3; color: var(--color-navy); margin: 0 0 0.8rem; }
  .hm-read-card p { font-size: 0.95rem; line-height: 1.6; color: var(--color-slate); margin: 0 0 1rem; flex: 1; }
  .hm-read-card small { color: var(--color-slate); font-size: 0.8rem; }
  .hm-read-more { margin: 2.2rem 0 0; }
  .hm-read-more a { font-family: var(--font-ui); font-weight: 500; color: var(--color-gold); text-decoration: none; }
  .hm-read-more a:hover { color: var(--color-gold-hover); }

  /* ---------- NEWSLETTER BAND (kept) ---------- */
  .cta-section { padding: 8rem 2rem; background: var(--color-navy); text-align: center; position: relative; overflow: hidden; }
  .cta-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--color-gold); }
