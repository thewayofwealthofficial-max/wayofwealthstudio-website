---
import Layout from '../layouts/Layout.astro';
import { LINKS } from '../config/links';

const title = "Way of Wealth — Behavioural money coaching for people who've tried everything else";
const description = "Behavioural economics-led coaching, workbooks, and a free quiz for people who've tried budgets, apps, and spreadsheets — and still feel stuck. MSc Behavioral Economics | Qualified Financial Planner.";
const canonical = LINKS.siteUrl;
---
<Layout title={title} description={description} canonical={canonical}>

<!-- HERO -->
<section class="hero">
  <div class="hero-credential">MSc Behavioral Economics &nbsp;|&nbsp; Qualified Financial Planner</div>
  <h1>You've tried budgets before.<br />Something keeps <em>getting in the way.</em></h1>
  <p class="hero-sub">It's not a willpower problem. It's not a maths problem. It's the way your brain is wired to handle money stress — and it's more common than you think.</p>
  <div class="hero-actions">
    <a href={LINKS.quiz} target="_blank" rel="noopener" class="btn-primary">Take the Money Beliefs Quiz</a>
    <a href={LINKS.newsletter} target="_blank" rel="noopener" class="btn-ghost">Join Finance Fridays Newsletter</a>
  </div>
</section>

<!-- ICEBERG — lifted verbatim from coaching.astro -->
<section class="iceberg-section">
  <div class="iceberg-inner reveal">
    <span class="section-tag">The Method, in One Image</span>
    <h2>Budgets live above the waterline.<br /><em>The real work is below.</em></h2>

    <div class="iceberg-layout">
      <!-- ABOVE WATER CARD -->
      <div class="iceberg-card iceberg-above">
        <p class="iceberg-card-label">ABOVE THE WATERLINE · BEHAVIOUR</p>
        <ul class="iceberg-card-list">
          <li>Budgets</li>
          <li>Spreadsheets</li>
          <li>Apps &amp; side hustles</li>
          <li>Finance books &amp; courses</li>
          <li>What you <em>track</em>, what you <em>try</em></li>
        </ul>
      </div>

      <!-- ICEBERG VISUAL -->
      <div class="iceberg-figure" aria-hidden="true">
        <svg viewBox="0 0 300 320" role="img" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="ice-above-v2" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#F5F0E8" />
              <stop offset="100%" stop-color="#E8D5B0" />
            </linearGradient>
            <linearGradient id="ice-below-v2" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1C2A3A" />
              <stop offset="100%" stop-color="#141F2B" />
            </linearGradient>
            <linearGradient id="water-v2" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#C4A265" stop-opacity="0.6" />
              <stop offset="100%" stop-color="#C4A265" stop-opacity="0" />
            </linearGradient>
          </defs>
          <polygon points="120,30 180,30 200,110 100,110" fill="url(#ice-above-v2)" stroke="#C4A265" stroke-width="1.5" />
          <line x1="10" y1="115" x2="290" y2="115" stroke="#C4A265" stroke-width="1.5" stroke-dasharray="4 5" />
          <rect x="10" y="115" width="280" height="6" fill="url(#water-v2)" />
          <polygon points="100,115 200,115 240,280 60,280" fill="url(#ice-below-v2)" stroke="#C4A265" stroke-width="1.2" />
          <path d="M 85 160 L 140 155" stroke="#C4A265" stroke-width="0.8" opacity="0.3" />
          <path d="M 80 210 L 180 205" stroke="#C4A265" stroke-width="0.8" opacity="0.25" />
          <path d="M 75 250 L 220 245" stroke="#C4A265" stroke-width="0.8" opacity="0.2" />
        </svg>
      </div>

      <!-- BELOW WATER CARD -->
      <div class="iceberg-card iceberg-below">
        <p class="iceberg-card-label">BELOW THE WATERLINE · THE STORY</p>
        <ul class="iceberg-card-list iceberg-card-list-below">
          <li>Inherited beliefs about money</li>
          <li>Fear of looking at the number</li>
          <li>Shame loops that override plans</li>
          <li>Identity tangled up in earning</li>
          <li>What you learned <em>before</em> you could name it</li>
        </ul>
      </div>
    </div>

    <p class="iceberg-caption">Most financial advice works above the line. The Money Story Method starts below it.</p>
  </div>
</section>

<!-- WHO THIS IS FOR -->
<section class="whofor">
  <div class="whofor-inner">
    <div class="reveal">
      <span class="section-tag">Who This Is For</span>
      <h2>You might recognise<br />yourself <em>here.</em></h2>
      <p class="whofor-intro">If one or more of these land, you're probably in the right place. None of this makes you broken — it makes you human, and it's more common than the finance world likes to admit.</p>
    </div>
    <ul class="checklist reveal">
      <li>You've downloaded budget templates you never opened</li>
      <li>You check your bank balance less often than you'd like to admit</li>
      <li>You know you "should" invest but the whole thing feels overwhelming</li>
      <li>You've had the shame spiral after an impulse purchase more than once</li>
      <li>Your income is irregular — or you're self-employed — and it keeps you up at night</li>
      <li>You want to feel calm about money, not just "good at it"</li>
    </ul>
  </div>
</section>

<!-- WHAT'S HERE -->
<section class="whats-here" id="whats-here">
  <div class="whats-here-inner">
    <div class="section-header reveal">
      <span class="section-tag">What's Actually Here</span>
      <h2>Simple, honest places to <em>start.</em></h2>
    </div>

    <!-- FLAGSHIP CARD: full-width row above the 4-card grid -->
    <a href="/coaching" class="flagship reveal">
      <div class="flagship-body">
        <span class="flagship-label">Flagship · 1:1 Programme</span>
        <h3>The Money Story Method</h3>
        <p class="flagship-sub">12-week 1:1 behavioural coaching</p>
        <p class="flagship-desc">The deep version of this work. For anyone who's tried everything and wants to go underneath the budgets and apps — into the story running the pattern.</p>
        <span class="flagship-cta">See the programme →</span>
      </div>
      <div class="flagship-aside" aria-hidden="true">
        <span class="flagship-aside-num">01</span>
        <span class="flagship-aside-label">The full method</span>
      </div>
    </a>

    <div class="offerings">
      <a href={LINKS.quiz} target="_blank" rel="noopener" class="offering reveal offering-link">
        <span class="offering-label">Free — Start Here</span>
        <h3>The Money Beliefs Quiz</h3>
        <p>A short, research-based quiz built on Brad Klontz's Money Scripts framework. Find out which of the four scripts you're running — Money Avoidance, Worship, Status, or Vigilance — in about three minutes.</p>
        <span class="offering-cta">Take the Quiz →</span>
      </a>
      <a href={LINKS.cheatSheet} target="_blank" rel="noopener" class="offering reveal offering-link">
        <span class="offering-label">Free — 2-page PDF</span>
        <h3>The Quiet Money Cheat Sheet</h3>
        <p>Three cognitive patterns quietly sabotaging your money — and the exact behavioural fix for each. <em>The Ostrich Effect. Loss Aversion. Present Bias.</em> Plain English, mapped to real decisions you're making this week.</p>
        <span class="offering-cta">Get the 2-page PDF →</span>
      </a>
      <a href={LINKS.etsy} target="_blank" rel="noopener" class="offering reveal offering-link">
        <span class="offering-label">Practical Tools</span>
        <h3>Worksheets &amp; Planners</h3>
        <p>A small, growing collection of judgement-free tools designed for people who've already tried the usual apps and templates. Available on Etsy, priced so you can actually try one.</p>
        <span class="offering-cta">Browse on Etsy →</span>
      </a>
      <a href={LINKS.cheatSheet} target="_blank" rel="noopener" class="offering reveal offering-link">
        <span class="offering-label">Weekly Email</span>
        <h3>Notes on the Quiet Side of Money</h3>
        <p>Short, honest emails on money, behaviour, and what the research actually says. One email a week, no pressure, and one-click unsubscribe any time.</p>
        <span class="offering-cta">Subscribe →</span>
      </a>
    </div>
  </div>
</section>

<!-- ABOUT (short) -->
<section class="about" id="about">
  <div class="about-inner reveal">
    <span class="section-tag">About</span>
    <div class="about-layout">
      <figure class="about-portrait">
        <img src="/images/joel-headshot.jpg" alt="Joel — Way of Wealth" loading="lazy" />
        <figcaption>Joel · MSc Behavioural Economics · QFP (UK)</figcaption>
      </figure>
      <div class="about-body">
        <h2>A quick note on <em>why me.</em></h2>
        <p>I studied behavioural economics at MSc level to understand why smart, capable people make money decisions that don't look logical on paper.</p>
        <p>Then I spent years as a qualified financial planner, watching people walk out of meetings with sound plans and change almost nothing about how they lived.</p>
        <p>Way of Wealth is what I built to work the layer underneath — the one every standard plan skips over.</p>
        <a href="/coaching#origin" class="about-link">Read the full story →</a>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section" id="start">
  <div class="cta-inner reveal">
    <h2>Start where it's <em>quiet.</em></h2>
    <p>Three cognitive patterns run most of the money decisions people end up regretting — <em>the Ostrich Effect, Loss Aversion, Present Bias.</em> Two pages. Plain language. The exact behavioural fix for each. Sent to your inbox in seconds.</p>
    <a href={LINKS.cheatSheet} target="_blank" rel="noopener" class="btn-primary btn-primary-lg">Send me the cheat sheet</a>
    <div class="cta-reassure">One email. Unsubscribe any time. No upsells, no webinar, no catch.</div>
  </div>
</section>

</Layout>

<style>
  /* --- HERO --- */
  .hero {
    min-height: 92vh;
    background: var(--color-navy);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 9rem 2rem 5rem;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 4px;
    background: var(--color-gold);
  }
  .hero::after {
    content: '';
    position: absolute;
    top: -30%; left: 50%;
    transform: translateX(-50%);
    width: 900px; height: 900px;
    background: radial-gradient(ellipse, rgba(196, 162, 101, 0.05) 0%, transparent 65%);
    pointer-events: none;
  }
  .hero-credential {
    font-family: var(--font-heading-sc);
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    margin-bottom: 2.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(196, 162, 101, 0.4);
    position: relative;
    z-index: 2;
  }
  .hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    max-width: 920px;
    color: var(--color-cream);
    position: relative;
    z-index: 2;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--color-gold);
    font-weight: 400;
  }
  .hero-sub {
    font-family: var(--font-body);
    font-size: 1.15rem;
    color: rgba(245, 240, 232, 0.82);
    max-width: 580px;
    line-height: 1.75;
    margin-top: 2rem;
    font-weight: 400;
    position: relative;
    z-index: 2;
  }
  .hero-actions {
    margin-top: 2.75rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    position: relative;
    z-index: 2;
  }

  /* --- ICEBERG (lifted from coaching.astro) --- */
  .iceberg-section {
    padding: 6rem 2rem;
    background: var(--color-cream);
  }
  .iceberg-inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }
  .iceberg-section h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-charcoal);
    margin-bottom: 2.5rem;
  }
  .iceberg-section h2 em { font-style: italic; color: var(--color-gold); font-weight: 400; }
  .iceberg-layout {
    display: grid;
    grid-template-columns: 1fr 280px 1fr;
    gap: 2rem;
    align-items: center;
    margin-bottom: 2rem;
  }
  .iceberg-figure {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .iceberg-figure svg {
    width: 100%;
    max-width: 260px;
    height: auto;
  }
  .iceberg-card {
    padding: 1.75rem;
    border-radius: 8px;
    text-align: left;
  }
  .iceberg-above {
    background: var(--color-bg-white);
    border: 1px solid var(--color-border-warm);
  }
  .iceberg-below {
    background: var(--color-navy);
    color: var(--color-cream);
  }
  .iceberg-card-label {
    font-family: var(--font-heading-sc);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--color-gold);
    margin: 0 0 0.85rem;
  }
  .iceberg-above .iceberg-card-label { color: var(--color-slate); }
  .iceberg-card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.85;
  }
  .iceberg-above .iceberg-card-list { color: var(--color-charcoal); }
  .iceberg-below .iceberg-card-list { color: var(--color-cream); }
  .iceberg-card-list li { position: relative; padding-left: 1rem; }
  .iceberg-card-list li::before {
    content: '·';
    color: var(--color-gold);
    position: absolute;
    left: 0;
    font-weight: 700;
  }
  .iceberg-card-list em { font-style: italic; color: var(--color-gold); }
  .iceberg-below .iceberg-card-list em { color: var(--color-gold-subtle); }
  .iceberg-caption {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-slate);
    margin-top: 2rem;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }
  @media (max-width: 900px) {
    .iceberg-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .iceberg-figure { order: 2; }
    .iceberg-above { order: 1; }
    .iceberg-below { order: 3; }
    .iceberg-figure svg { max-width: 200px; }
  }

  /* --- WHO THIS IS FOR --- */
  .whofor { padding: 7rem 2rem; background: var(--color-bg-white); }
  .whofor-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 5rem;
    align-items: start;
  }
  .whofor h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 3.2vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-charcoal);
    margin-bottom: 1.5rem;
  }
  .whofor h2 em { font-style: italic; color: var(--color-gold); font-weight: 400; }
  .whofor p.whofor-intro {
    color: var(--color-slate);
    font-size: 1.02rem;
    line-height: 1.8;
  }
  .checklist { list-style: none; padding: 0; }
  .checklist li {
    padding: 1.1rem 0 1.1rem 2rem;
    border-bottom: 1px solid var(--color-border-warm);
    font-size: 1.02rem;
    color: var(--color-charcoal);
    position: relative;
    line-height: 1.6;
  }
  .checklist li:last-child { border-bottom: none; }
  .checklist li::before {
    content: '—';
    position: absolute;
    left: 0;
    top: 1.1rem;
    color: var(--color-gold);
    font-weight: 500;
  }

  /* --- WHAT'S HERE --- */
  .whats-here { padding: 7rem 2rem; background: var(--color-bg-cool); }
  .whats-here-inner { max-width: 1100px; margin: 0 auto; }
  .whats-here .section-header { text-align: center; margin-bottom: 4rem; }
  .whats-here h2 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 400;
    color: var(--color-charcoal);
    line-height: 1.2;
  }
  .whats-here h2 em { font-style: italic; color: var(--color-gold); font-weight: 400; }

  /* FLAGSHIP CARD — full-width row above the 4-card grid */
  .flagship {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 2.5rem;
    align-items: stretch;
    background: var(--color-navy);
    color: var(--color-cream);
    padding: 2.75rem 3rem;
    border-radius: 8px;
    border: 2px solid var(--color-gold);
    box-shadow: 0 8px 28px rgba(28, 42, 58, 0.12);
    text-decoration: none;
    margin-bottom: 2.25rem;
    transition: transform 0.3s, box-shadow 0.3s;
    position: relative;
    overflow: hidden;
  }
  .flagship::before {
    content: '';
    position: absolute;
    top: -40%; right: -15%;
    width: 360px; height: 360px;
    background: radial-gradient(ellipse, rgba(196, 162, 101, 0.10) 0%, transparent 65%);
    pointer-events: none;
  }
  .flagship:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgba(28, 42, 58, 0.18);
  }
  .flagship-body { position: relative; z-index: 2; }
  .flagship-label {
    font-family: var(--font-heading-sc);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.9rem;
  }
  .flagship h3 {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-cream);
    margin-bottom: 0.35rem;
  }
  .flagship-sub {
    font-family: var(--font-heading-sc);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: var(--color-gold-subtle);
    margin-bottom: 1.1rem;
  }
  .flagship-desc {
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.8;
    color: rgba(245, 240, 232, 0.82);
    max-width: 640px;
    margin-bottom: 1.4rem;
  }
  .flagship-cta {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-gold);
    transition: transform 0.3s, color 0.3s;
  }
  .flagship:hover .flagship-cta {
    color: var(--color-gold-hover);
    transform: translateX(3px);
  }
  .flagship-aside {
    position: relative;
    z-index: 2;
    border-left: 1px solid rgba(196, 162, 101, 0.3);
    padding-left: 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .flagship-aside-num {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 3.2rem;
    color: var(--color-gold);
    line-height: 1;
  }
  .flagship-aside-label {
    font-family: var(--font-heading-sc);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    color: rgba(245, 240, 232, 0.6);
    margin-top: 0.75rem;
  }

  .offerings {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }
  .offering {
    background: var(--color-bg-white);
    padding: 2.25rem 2.25rem 2.25rem 2.5rem;
    border-left: 3px solid var(--color-gold);
    border-radius: 6px;
    box-shadow: 0 1px 3px rgba(28, 42, 58, 0.05);
    transition: transform 0.3s, box-shadow 0.3s;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .offering-link {
    text-decoration: none;
    color: inherit;
  }
  .offering:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(28, 42, 58, 0.08);
  }
  .offering-link:hover .offering-cta {
    color: var(--color-gold-hover);
    transform: translateX(2px);
  }
  .offering-label {
    font-family: var(--font-heading-sc);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--color-slate);
    margin-bottom: 0.6rem;
    display: block;
  }
  .offering h3 {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--color-charcoal);
    margin-bottom: 0.85rem;
    line-height: 1.3;
  }
  .offering p {
    font-family: var(--font-body);
    font-size: 0.98rem;
    color: var(--color-slate);
    line-height: 1.75;
    flex: 1;
  }
  .offering-cta {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-gold);
    letter-spacing: 0.02em;
    transition: color 0.3s, transform 0.3s;
  }

  /* --- ABOUT (short) --- */
  .about { padding: 7rem 2rem; background: var(--color-bg-white); }
  .about-inner { max-width: 1000px; margin: 0 auto; }
  .about-inner > .section-tag { text-align: center; }
  .about-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 3rem;
    align-items: start;
    margin-top: 1rem;
  }
  .about-portrait { margin: 0; }
  .about-portrait img {
    width: 100%;
    border-radius: 8px;
    display: block;
  }
  .about-portrait figcaption {
    font-family: var(--font-heading-sc);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--color-slate);
    margin-top: 0.75rem;
    text-align: center;
  }
  .about h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 3.2vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-charcoal);
    margin-bottom: 1.5rem;
  }
  .about h2 em { font-style: italic; color: var(--color-gold); font-weight: 400; }
  .about-body p {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-charcoal);
    line-height: 1.85;
    margin-bottom: 1.1rem;
  }
  .about-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-gold);
    text-decoration: none;
    transition: color 0.3s, transform 0.3s;
  }
