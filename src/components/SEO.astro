---
import { LINKS } from '../config/links';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  articleSchema?: Record<string, unknown>;
  noindex?: boolean;
}

const SITE = LINKS.siteUrl;
const DEFAULT_OG = `${SITE}/og-default.svg`;

const {
  title,
  description,
  ogImage = DEFAULT_OG,
  canonical,
  articleSchema,
  noindex = false,
} = Astro.props;

// Netlify serves every page at a URL ending in "/" and 301s the version without it,
// so the canonical must end in "/" or Google sees it as a redirect and won't index the page.
const rawCanonical = canonical ?? new URL(Astro.url.pathname, SITE).toString();
const cu = new URL(rawCanonical);
if (!cu.pathname.endsWith('/') && !/\.[a-z0-9]+$/i.test(cu.pathname)) cu.pathname += '/';
const canonicalUrl = cu.toString();
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={articleSchema ? 'article' : 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content="Way of Wealth" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Author / publisher -->
<meta name="author" content="Joel — Way of Wealth" />
<meta name="theme-color" content="#1C2A3A" />

<!-- RSS discovery -->
<link rel="alternate" type="application/rss+xml" title="Way of Wealth — Blog" href="/rss.xml" />

{articleSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}
